extends RefCounted
const Calendar = preload("res://scripts/mechanics/core/calendar.gd")
var t

func _init(test_runner) -> void:
	t = test_runner

func run() -> void:
	combat_and_health()
	careers_and_journalism()
	social_profiles_and_memory()
	clubs_and_interiors()
	training_and_lifecycle()
	validation_and_replay()
	timed_games_and_gatherings()
	wardrobes_and_descriptors()

func _npc(sim, id: String = "a") -> void:
	t.command(sim, "social", "generate", {"id": id})

func _equipment(sim, id: String) -> void:
	t.command(sim, "inventory", "add", {"id": id})
	t.command(sim, "world", "install", {"id": id})

func combat_and_health() -> void:
	var sim = t.fresh()
	_npc(sim)
	t.command(sim, "combat", "start", {"npc": "a"})
	var bare: Dictionary = sim.services.combat.forecast("jab")
	t._check(bare.ok and bare.data.accuracy > 0.0 and bare.data.accuracy < 1.0, "combat forecast exposes bounded accuracy")
	t._check(not sim.services.combat.forecast("slash").ok, "blade move requires equipped blade")
	t._check(not sim.command("combat", "action", {"action": "attack", "power": 9}).ok, "attack force cannot exceed configured range")
	t._check(not sim.command("combat", "action", {"action": "guard", "part": "unknown"}).ok, "guard rejects an unknown body zone")
	t.command(sim, "combat", "action", {"action": "stance", "id": "aggressive"})
	t._check(sim.services.combat.forecast("jab").data.damage > bare.data.damage, "aggressive stance increases damage with accuracy tradeoff")
	t.command(sim, "combat", "action", {"action": "guard"})
	t._check(sim.state.encounters.combat.guard and sim.state.encounters.combat.ap == 2, "stance and guard each spend an AP and record defense")
	t.command(sim, "combat", "action", {"action": "end_turn"})
	t._check(sim.state.encounters.combat.turn == 2, "opponent chooses and resolves its own turn")
	while sim.state.encounters.combat.status == "active": t.command(sim, "combat", "action", {"action": "escape"})
	var armed = t.fresh()
	_npc(armed)
	t.command(armed, "inventory", "add", {"id": "knife"})
	t.command(armed, "inventory", "equip", {"id": "knife"})
	armed.state.player.stats.agility = 100
	t.command(armed, "combat", "start", {"npc": "a"})
	t._check(armed.services.combat.forecast("slash").ok, "equipping a weapon unlocks its techniques")
	t.command(armed, "combat", "action", {"action": "attack", "move": "slash", "part": "body"})
	if armed.state.social.npcs.a.health == 100:
		t.command(armed, "combat", "action", {"action": "attack", "move": "slash", "part": "body"})
	t._check(armed.state.social.npcs.a.health < 100 and armed.services.health.record("a").bleeding > 0, "blade hit persists wound and bleeding outside combat")
	var stamina := float(armed.state.encounters.combat.stamina.player)
	t._check(stamina < 100.0, "attacks consume physical stamina separately from AP")
	var patient = t.fresh()
	patient.services.health.injure("player", "arms", 40.0, 2.0)
	var impaired := float(patient.services.character.effective_stat("strength"))
	t._check(impaired < float(patient.state.player.stats.strength), "injured arms reduce effective strength")
	t.command(patient, "clock", "advance", {"minutes": 30})
	t._check(patient.state.player.needs.health < 60.0, "untreated bleeding drains health with elapsed time")
	var before: Dictionary = patient.export_snapshot()
	t._check(not patient.command("health", "treat", {"id": "bandage"}).ok and patient.export_snapshot() == before, "missing medical supply rolls back treatment")
	t.command(patient, "inventory", "add", {"id": "bandage"})
	t.command(patient, "health", "treat", {"id": "bandage"})
	t._check(patient.services.health.record("player").bleeding == 0.0, "bandage stops bleeding and is consumed")
	t._check(not patient.command("health", "treat", {"id": "bandage"}).ok, "treatment cooldown prevents repeated application")
	t.command(patient, "health", "treat", {"id": "clinic"})
	t._check(patient.services.character.effective_stat("strength") > impaired, "clinical care repairs functional injury")
	t._check(not patient.command("character", "treat", {"part": "arms"}).ok, "legacy treatment entry cannot bypass clinical cooldown")
	t.command(patient, "inventory", "add", {"id": "bandage"})
	t.command(patient, "clock", "advance", {"minutes": 30})
	var care_until := int(patient.services.health.record("player").care_until)
	t.command(patient, "health", "treat", {"id": "bandage"})
	t._check(patient.services.health.record("player").care_until == care_until, "bandage cannot cancel ongoing clinical recovery")
	var toxin = t.fresh()
	t.command(toxin, "health", "intoxicate", {"amount": 80})
	t._check(toxin.services.character.effective_stat("agility") < 5.0, "intoxication impairs attributes")
	t.command(toxin, "clock", "advance", {"minutes": 240})
	t._check(toxin.services.health.record("player").intoxication == 0.0, "intoxication wears off with crossed hours")
	var crime = t.fresh()
	_npc(crime)
	var crime_before: Dictionary = crime.export_snapshot()
	t._check(not crime.command("security", "steal", {"npc": "a", "item": "missing"}).ok and crime.export_snapshot() == crime_before, "invalid target item rejected before risk roll")
	crime.state.security.fine = 30
	var funds := int(crime.state.economy.cash)
	t.command(crime, "security", "pay_fine")
	t._check(crime.state.security.fine == 0 and crime.state.economy.cash == funds - 30, "police fine has explicit settlement")
	crime.state.security.fine = 40
	t.command(crime, "security", "serve_sentence")
	t._check(crime.state.security.fine == 0, "alternative sentence consumes game time")

func careers_and_journalism() -> void:
	var sim = t.fresh({"settings": {"start_minutes": 480, "start_cash": 1000}})
	_equipment(sim, "computer")
	t._check(not sim.command("careers", "take_contract", {"id": "application"}).ok, "advanced contract requires profession level")
	t.command(sim, "careers", "shift", {"id": "digital"})
	t.command(sim, "careers", "shift", {"id": "digital"})
	t._check(sim.state.careers.professions.digital.level == 2, "professional experience produces promotion")
	t._check(not sim.command("careers", "shift", {"id": "digital"}).ok, "shifts share daily profession limit")
	t.command(sim, "careers", "take_contract", {"id": "small_website"})
	t.command(sim, "careers", "work_contract", {"id": "small_website", "minutes": 120})
	t._check(sim.state.careers.contracts.small_website.status == "completed", "skill-driven contract progress reaches completion")
	var cash := int(sim.state.economy.cash)
	t.command(sim, "careers", "claim_contract", {"id": "small_website"})
	t._check(sim.state.economy.cash > cash, "quality-adjusted contract reward paid")
	t._check(not sim.command("careers", "claim_contract", {"id": "small_website"}).ok, "contract cannot pay twice")
	t.command(sim, "character", "rest", {"minutes": 120})
	for topic in ["games", "education", "creative"]: t.command(sim, "careers", "stream", {"id": topic, "minutes": 15})
	t._check(sim.state.careers.streams.size() == 3 and sim.state.economy.channel.followers > 0, "stream topics produce audience reports and channel growth")
	var timeout = t.fresh({"contracts": {"urgent": {"skill": "computing", "effort": 100, "deadline": 10, "pay": 100}}})
	t.command(timeout, "careers", "take_contract", {"id": "urgent"})
	var before: Dictionary = timeout.export_snapshot()
	t._check(not timeout.command("careers", "work_contract", {"id": "urgent", "minutes": 20}).ok and timeout.export_snapshot() == before, "work that crosses deadline is rejected before charging")
	t.command(timeout, "clock", "advance", {"minutes": 10})
	t._check(timeout.state.careers.contracts.urgent.status == "failed", "contract expires at exact deadline")
	var reporter = t.fresh()
	_npc(reporter)
	t.command(reporter, "careers", "investigate", {"id": "neighborhood_report"})
	t._check(not reporter.command("careers", "investigate", {"id": "club_report"}).ok, "junior reporter has one parallel publication slot")
	t._check(not reporter.command("careers", "publish", {"id": "neighborhood_report"}).ok, "publication requires verification")
	t._check(not reporter.command("careers", "verify", {"id": "neighborhood_report"}).ok, "verification requires multiple sources")
	t.command(reporter, "careers", "interview", {"id": "neighborhood_report", "npc": "a"})
	t._check(not reporter.command("careers", "interview", {"id": "neighborhood_report", "npc": "a"}).ok, "same source cannot be counted twice")
	t.command(reporter, "careers", "verify", {"id": "neighborhood_report"})
	t.command(reporter, "careers", "publish", {"id": "neighborhood_report"})
	t._check(reporter.state.player.skills.journalism > 0 and not reporter.command("careers", "publish", {"id": "neighborhood_report"}).ok, "verified publication improves skill and settles only once")
	t.command(reporter, "careers", "investigate", {"id": "club_report"})
	reporter.state.careers.professions.journalism.level = 8
	t._check(reporter.services.careers.publication_capacity() == 3, "journalist career unlocks concurrent research at configured levels")

func social_profiles_and_memory() -> void:
	var sim = t.fresh()
	_npc(sim)
	_npc(sim, "b")
	t._check(sim.state.social.npcs.a.traits.size() == 6 and sim.state.social.npcs.a.biography.has("family"), "NPC has personality dimensions and biography structure")
	t._check(sim.services.social_rules.describe("a").contains(str(sim.state.social.npcs.a.name)) and sim.state.social.npcs.a.biography.timeline.size() == 3, "biography has coherent milestones and independently written description")
	t._check(not sim.command("social_rules", "ask_history", {"id": "a"}).ok, "personal history requires established trust")
	t.command(sim, "social", "relationship", {"id": "a", "changes": {"trust": 15}})
	var disclosure: Dictionary = t.command(sim, "social_rules", "ask_history", {"id": "a"})
	t._check(disclosure.data.new_disclosure, "trusted conversation discloses generated personal history")
	disclosure = t.command(sim, "social_rules", "ask_history", {"id": "a"})
	t._check(not disclosure.data.new_disclosure, "repeated biography conversation grants no repeated discovery bonus")
	var forecast: Dictionary = sim.services.social_rules.conversation_forecast("a", "talk")
	t.command(sim, "social", "interact", {"id": "a", "action": "talk"})
	t._check(sim.services.social_rules.conversation_forecast("a", "talk").data.chance < forecast.data.chance, "repeating conversation reduces acceptance")
	t.command(sim, "clock", "advance", {"minutes": 1441})
	t._check(sim.services.social_rules.conversation_forecast("a", "talk").data.repeats == 0, "old conversation history loses repetition penalty")
	t.command(sim, "social_rules", "promise", {"id": "a", "promise": "read_book"})
	t._check(not sim.command("social_rules", "fulfill", {"id": "a", "promise": "read_book"}).ok, "promise requires real objective state")
	t.command(sim, "character", "train", {"skill": "study", "xp": 10})
	t.command(sim, "social_rules", "fulfill", {"id": "a", "promise": "read_book"})
	t._check(not sim.command("social_rules", "fulfill", {"id": "a", "promise": "read_book"}).ok, "promise reward cannot repeat")
	t.command(sim, "social_rules", "promise", {"id": "b", "promise": "complete_project"})
	t.command(sim, "clock", "advance", {"minutes": 2880})
	t._check(sim.state.social.promises["b:complete_project"].status == "broken", "broken promise persists with consequences")
	var romance = t.fresh()
	_npc(romance)
	t.command(romance, "social", "relationship", {"id": "a", "changes": {"affinity": 40, "trust": 40, "attraction": 40}})
	t.command(romance, "social_rules", "partner", {"id": "a"})
	t._check(romance.services.social.relationship("a", "player").status == "partner", "mutual eligible partnership forms")
	t.command(romance, "social_rules", "breakup", {"id": "a"})
	t._check(not romance.command("social_rules", "partner", {"id": "a"}).ok, "separation cooldown prevents instant reunion")
	romance.state.social.npcs.a.attracted_to = ["female"]
	t._check(not romance.services.social_rules.compatibility("a", "player").data.mutual_attraction, "romantic matching respects mutual attraction")
	var filtered = t.fresh()
	_npc(filtered)
	t.command(filtered, "social", "relationship", {"id": "a", "changes": {"affinity": 40, "trust": 40, "attraction": 40}})
	t.command(filtered, "preferences", "content_tag", {"id": "romance", "enabled": false})
	t._check(not filtered.command("social_rules", "partner", {"id": "a"}).ok, "romance filter applies to relationship actions")
	t._check(not filtered.command("social_rules", "date", {"id": "a"}).ok, "romance filter also blocks date path")
	sim.state.social.npcs.a.traits.loyalty = 10
	t._check(sim.services.social_rules.betrayal_risk("a") > 0.0, "low loyalty creates a bounded betrayal risk")
	t.command(sim, "preferences", "content_tag", {"id": "betrayal", "enabled": false})
	t._check(sim.services.social_rules.betrayal_risk("a") == 0.0, "betrayal content filter removes autonomous betrayal risk")

func clubs_and_interiors() -> void:
	var sim = t.fresh({"settings": {"start_cash": 5000}})
	_npc(sim)
	_npc(sim, "b")
	t.command(sim, "organizations", "create", {"id": "creative_collective"})
	for npc in ["a", "b"]: t.command(sim, "organizations", "recruit", {"id": "creative_collective", "npc": npc})
	t.command(sim, "institutions", "policy", {"id": "creative_collective", "focus": "festival", "wage": 10})
	var total := int(sim.state.organizations.creative_collective.budget) + int(sim.state.social.npcs.a.money) + int(sim.state.social.npcs.b.money)
	t.command(sim, "clock", "advance", {"minutes": 13})
	t._check(sim.state.organizations.creative_collective.budget == 100 and sim.state.social.npcs.a.money == 100, "idle membership does not pay an unworked wage")
	t._check(total == sim.state.organizations.creative_collective.budget + sim.state.social.npcs.a.money + sim.state.social.npcs.b.money, "payroll conserves funds")
	t.command(sim, "institutions", "election", {"id": "creative_collective", "candidates": ["a", "b"]})
	t.command(sim, "institutions", "vote", {"id": "creative_collective", "npc": "a", "candidate": "b"})
	t._check(not sim.command("institutions", "vote", {"id": "creative_collective", "npc": "a", "candidate": "a"}).ok, "member cannot cast duplicate vote")
	t.command(sim, "institutions", "vote", {"id": "creative_collective", "npc": "b", "candidate": "b"})
	t.command(sim, "institutions", "resolve_election", {"id": "creative_collective"})
	t._check(sim.state.organizations.creative_collective.members.b.role == "leader", "election appoints selected leader")
	t.command(sim, "institutions", "election", {"id": "creative_collective", "candidates": ["a", "b"]})
	t.command(sim, "organizations", "dismiss", {"id": "creative_collective", "npc": "a"})
	t._check(sim.state.organizations.creative_collective.election.status == "cancelled", "roster changes cancel obsolete ballots instead of electing absent members")
	t.command(sim, "organizations", "recruit", {"id": "creative_collective", "npc": "a"})
	t.command(sim, "institutions", "policy", {"id": "creative_collective", "focus": "festival", "wage": 0})
	t.command(sim, "institutions", "campaign", {"id": "creative_collective", "campaign": "festival"})
	for npc in ["a", "b"]: t.command(sim, "organizations", "assign", {"id": "creative_collective", "npc": npc, "task": "article"})
	t.command(sim, "clock", "advance", {"minutes": 5 * 1440})
	t._check(sim.state.organizations.creative_collective.campaigns.festival.status == "completed", "staff and focus advance multi-stage festival")
	t.command(sim, "institutions", "claim_campaign", {"id": "creative_collective", "campaign": "festival"})
	t._check(not sim.command("institutions", "claim_campaign", {"id": "creative_collective", "campaign": "festival"}).ok, "campaign reward settles exactly once")
	var home = t.fresh({"settings": {"start_cash": 5000}})
	t.command(home, "housing", "buy", {"id": "apartment"})
	t.command(home, "housing", "move_in", {"id": "apartment"})
	_npc(home)
	home.state.social.npcs.a.home = "global_map"
	t.command(home, "housing", "tenant", {"id": "apartment", "npc": "a"})
	t._check(home.state.social.npcs.a.home == "bedroom", "tenant schedule uses the acquired property's location as home")
	t.command(home, "housing", "remove_tenant", {"id": "apartment", "npc": "a"})
	t._check(home.state.social.npcs.a.home == "global_map", "tenant departure restores original residence")
	for item in ["desk", "chair", "bookshelf"]:
		t.command(home, "inventory", "add", {"id": item})
		t.command(home, "housing", "furnish", {"id": "apartment", "item": item})
	t.command(home, "interior", "place", {"id": "apartment", "item": "desk", "x": 0, "y": 0})
	var before: Dictionary = home.export_snapshot()
	t._check(not home.command("interior", "place", {"id": "apartment", "item": "chair", "x": 1, "y": 0}).ok and home.export_snapshot() == before, "overlapping furniture placement rolls back")
	t._check(not home.command("interior", "place", {"id": "apartment", "item": "bookshelf", "x": 7, "y": 0, "rotated": true}).ok, "rotated furniture respects room boundary")
	t.command(home, "interior", "place", {"id": "apartment", "item": "bookshelf", "x": 6, "y": 4, "rotated": true})
	t._check(home.services.interior.render_plan("apartment").size() == 2, "interior supplies ordered renderer-independent layout")
	t.command(home, "interior", "remove", {"id": "apartment", "item": "desk"})
	t._check(home.state.inventory.items.desk == 1 and not home.state.housing.properties.apartment.equipment.has("desk"), "removing furniture restores inventory ownership")

func training_and_lifecycle() -> void:
	var sim = t.fresh({"settings": {"start_minutes": 480}})
	for i in range(3): t.command(sim, "activities", "practice", {"id": "strength"})
	t._check(sim.state.player.stats.strength == 6 and sim.state.player.training.strength == 20, "training grows attribute and retains progress")
	t._check(not sim.command("activities", "practice", {"id": "strength"}).ok, "overtraining prevents unlimited daily growth")
	var baseline := float(sim.services.character.effective_stat("strength"))
	t.command(sim, "lifecycle", "start", {"id": "fatigue"})
	t._check(sim.services.character.effective_stat("strength") < baseline, "long condition applies temporary attribute modifier")
	t.command(sim, "clock", "advance", {"minutes": 180})
	t._check(sim.services.character.effective_stat("strength") == baseline, "condition modifier ends without changing base attributes")
	var family = t.fresh({"settings": {"start_cash": 1000}})
	_npc(family)
	t.command(family, "lifecycle", "start", {"id": "pregnancy", "target": "a", "partner": "player"})
	t.command(family, "health", "prenatal_care", {"target": "a"})
	t._check(not family.command("health", "prenatal_care", {"target": "a"}).ok, "care cannot be repeatedly farmed on same day")
	var deadline := int(family.state.conditions["a:pregnancy"].end_time)
	while int(family.state.clock.total_minutes) < deadline:
		var delta := mini(43200, deadline - int(family.state.clock.total_minutes))
		t.command(family, "clock", "advance", {"minutes": delta})
	t._check(family.state.conditions["a:pregnancy"].stage == 4 and family.state.healthcare.family.size() == 1, "nine real calendar months process all stages and one family outcome")
	t.command(family, "clock", "advance", {"minutes": 60})
	t._check(family.state.healthcare.family.size() == 1 and family.state.social.npcs.a.appearance.pregnancy_stage == 0, "completed family condition cannot trigger birth twice")

func validation_and_replay() -> void:
	var bad = t.fresh({"combat_moves": {"invalid": {"ap": 0, "stamina": 1}}})
	t._check(not bad.configuration_error.is_empty(), "zero-cost attacks rejected at catalog boundary")
	bad = t.fresh({"furniture": {"bad": {"size": [-1, 2]}}})
	t._check(not bad.configuration_error.is_empty(), "invalid furniture geometry rejected")
	bad = t.fresh({"conditions": {"reversed": {"duration": 100, "stages": [{"after": 80}, {"after": 20}]}}})
	t._check(not bad.configuration_error.is_empty(), "out-of-order condition stages rejected")
	var sim = t.fresh()
	_npc(sim)
	var before: Dictionary = sim.export_snapshot()
	t._check(not sim.command("combat", "action", {"power": []}).ok and sim.export_snapshot() == before, "wrong argument types rejected without mutation")
	var broken := before.duplicate(true)
	broken.state.healthcare.records.player = {"bleeding": -1}
	t._check(not sim.restore_snapshot(broken).ok and sim.export_snapshot() == before, "invalid medical container rejected without changing live state")
	var replay = t.fresh()
	t._check(replay.restore_snapshot(JSON.parse_string(JSON.stringify(before))).ok, "expanded state supports existing in-memory snapshot contract")
	t.command(sim, "clock", "advance", {"minutes": 1440})
	t.command(replay, "clock", "advance", {"minutes": 1440})
	t._check(JSON.parse_string(JSON.stringify(sim.export_snapshot())) == JSON.parse_string(JSON.stringify(replay.export_snapshot())), "autonomous expanded world reproduces after JSON round trip")

func timed_games_and_gatherings() -> void:
	var sim = t.fresh()
	t.command(sim, "encounters", "game_start", {"type": "timing", "required_reps": 3})
	var offset := int(float(sim.state.encounters.game.target) * 1000.0)
	for i in range(3): t.command(sim, "encounters", "game_input", {"elapsed_ms": offset + i * 1000})
	t._check(sim.state.encounters.game.status == "won" and sim.state.player.skills.fighting > 0, "rotating timing window awards successful repeated inputs")
	t._check(not sim.command("encounters", "game_input", {"elapsed_ms": offset + 4000}).ok, "completed timing challenge cannot award XP twice")
	var exercise = t.fresh()
	t.command(exercise, "encounters", "game_start", {"type": "pushups", "required_reps": 2})
	t._check(not exercise.command("encounters", "game_input", {"elapsed_ms": 10}).ok, "exercise input debounce rejects unrealistically fast presses")
	var elapsed := 0
	while exercise.state.encounters.game.status == "active" and elapsed < 10000:
		elapsed += 120
		t.command(exercise, "encounters", "game_input", {"elapsed_ms": elapsed})
	t._check(exercise.state.encounters.game.status == "won" and exercise.state.encounters.game.reps == 2, "push-up meter decays between presses and counts repetitions")
	t._check(exercise.state.player.needs.energy < 100, "successful exercise has physical resource cost")
	var timeout = t.fresh()
	t.command(timeout, "encounters", "game_start", {"type": "pushups", "duration_ms": 1000})
	t.command(timeout, "encounters", "game_input", {"elapsed_ms": 1001})
	t._check(timeout.state.encounters.game.status == "lost", "timed exercise stops at deadline")
	var burglar = t.fresh()
	_npc(burglar)
	t.command(burglar, "inventory", "add", {"id": "lockpick"})
	var funds := int(burglar.state.economy.cash)
	t.command(burglar, "security", "begin_burglary", {"npc": "a"})
	t._check(not burglar.state.inventory.items.has("lockpick"), "interactive burglary consumes one actual tool")
	for i in range(3): t.command(burglar, "encounters", "game_input", {"value": burglar.state.encounters.game.pins[i]})
	t._check(burglar.state.economy.cash == funds + 30 and burglar.state.social.npcs.a.money == 70, "solved lock grants target loot exactly once")
	t._check(burglar.state.encounters.game.context.resolved, "burglary context is marked settled")
	var armed_target = t.fresh({"npc_templates": {"armed": {"weapon": "knife"}}})
	t.command(armed_target, "social", "generate", {"id": "guard", "template": "armed"})
	t.command(armed_target, "inventory", "add", {"id": "lockpick"})
	t.command(armed_target, "security", "begin_burglary", {"npc": "guard", "item": "knife"})
	for i in range(3): t.command(armed_target, "encounters", "game_input", {"value": armed_target.state.encounters.game.pins[i]})
	t._check(armed_target.state.social.npcs.guard.weapon.is_empty() and armed_target.state.inventory.items.knife == 1, "taking an equipped target item transfers ownership and removes its combat use")
	var gathering = t.fresh()
	for id in ["a", "b"]:
		_npc(gathering, id)
		t.command(gathering, "social", "relationship", {"id": id, "changes": {"trust": 15}})
	t.command(gathering, "inventory", "add", {"id": "meal", "quantity": 2})
	t.command(gathering, "social_rules", "gathering", {"candidates": ["a", "b"]})
	t._check(not gathering.state.inventory.items.has("meal") and gathering.services.social.relationship("a", "b").trust > 0, "gathering consumes shared food and develops NPC-to-NPC ties")
	t._check(gathering.state.social.npcs.a.memories[-1].kind == "gathering", "group event becomes social memory")

func wardrobes_and_descriptors() -> void:
	var sim = t.fresh({"settings": {"start_minutes": 480}, "npc_templates": {"worker": {
		"schedule": [{"hours": [480, 600], "location": "global_map", "activity": "work"},
			{"hours": [600, 1200], "location": "global_map", "activity": "training"}]}}})
	t.command(sim, "social", "generate", {"id": "worker", "template": "worker"})
	t._check(sim.state.social.npcs.worker.equipped.top == "work_top", "NPC wardrobe follows scheduled work context")
	t.command(sim, "clock", "advance", {"minutes": 120})
	t._check(sim.state.social.npcs.worker.equipped.top == "training_top", "NPC changes owned outfit when scheduled activity changes")
	var before: Dictionary = sim.export_snapshot()
	t._check(not sim.command("appearance", "outfit", {"id": "casual"}).ok and sim.export_snapshot() == before, "unowned player outfit is rejected atomically")
	for item in ["casual_top", "trousers"]: t.command(sim, "inventory", "add", {"id": item})
	t.command(sim, "appearance", "outfit", {"id": "casual"})
	t._check(sim.state.inventory.equipped.top == "casual_top" and sim.state.inventory.equipped.bottom == "trousers", "complete outfit equips owned pieces across slots")
	t.command(sim, "appearance", "customize", {"features": {"hair": "short", "hair_color": "brown"}})
	var descriptor: Dictionary = sim.services.appearance.descriptor()
	descriptor.equipment.top.item = "mutated_copy"
	t._check(sim.services.appearance.descriptor().equipment.top.item == "casual_top" and sim.state.player.appearance.hair == "short", "visual descriptor is detached and preserves cosmetic features")
	t._check(not sim.command("appearance", "customize", {"features": {"pregnancy_stage": 99}}).ok, "cosmetic customization cannot forge lifecycle stage")
	t.command(sim, "inventory", "add", {"id": "jacket"})
	t.command(sim, "world", "travel", {"id": "apartment_hall"})
	t.command(sim, "world", "travel", {"id": "global_map"})
	t.command(sim, "social", "gift", {"id": "worker", "item": "jacket"})
	t.command(sim, "appearance", "equip", {"target": "worker", "id": "jacket"})
	t._check(sim.services.appearance.descriptor("worker").equipment.outerwear.item == "jacket", "NPC can wear a gift only after actual ownership transfer")
	var theft = t.fresh({"npc_templates": {"one_outfit": {"wardrobe": ["casual"]}}})
	t.command(theft, "social", "generate", {"id": "resident", "template": "one_outfit"})
	t.command(theft, "inventory", "add", {"id": "lockpick"})
	t.command(theft, "security", "begin_burglary", {"npc": "resident", "item": "casual_top"})
	for i in range(3): t.command(theft, "encounters", "game_input", {"value": theft.state.encounters.game.pins[i]})
	t.command(theft, "clock", "advance", {"minutes": 60})
	t._check(not theft.state.social.npcs.resident.equipped.has("top") and not theft.state.social.npcs.resident.inventory.has("casual_top"), "automatic wardrobe never recreates a stolen equipped piece")
	var bad = t.fresh({"outfits": {"invalid": {"items": ["casual_top", "work_top"]}}})
	t._check(not bad.configuration_error.is_empty(), "outfit catalogue rejects duplicate equipment slots")
