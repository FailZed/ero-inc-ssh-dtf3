extends SceneTree

const Simulation = preload("res://scripts/mechanics/simulation.gd")
const Calendar = preload("res://scripts/mechanics/core/calendar.gd")
const Rules = preload("res://scripts/mechanics/core/rules.gd")
const Adapter = preload("res://scripts/mechanics/adapters/session_adapter.gd")
const QuestInventory = preload("res://scripts/mechanics/adapters/quest_inventory_controller.gd")
const AdvancedTests = preload("res://tests/mechanics/advanced.gd")
const ParityTests = preload("res://tests/mechanics/parity.gd")
const BalanceTests = preload("res://tests/mechanics/balance.gd")
const NpcLifeTests = preload("res://tests/mechanics/npc_life.gd")
const PersonalityTests = preload("res://tests/mechanics/human_social.gd")
const DialogueTests = preload("res://tests/mechanics/dialogue.gd")
var checks := 0
var failures: Array[String] = []

func _initialize() -> void:
	call_deferred("_run")

func _check(value: bool, description: String) -> void:
	checks += 1
	if not value:
		failures.append(description)
		printerr("FAIL: ", description)

func fresh(extensions: Dictionary = {}):
	return Simulation.new(42, extensions)

func command(sim, module_id: String, operation: String, args: Dictionary = {}) -> Dictionary:
	var result: Dictionary = sim.command(module_id, operation, args)
	_check(bool(result.ok), "%s.%s succeeds: %s" % [module_id, operation, str(result.get("error", ""))])
	return result

func _run() -> void:
	if "--housing-only" in OS.get_cmdline_user_args():
		_test_housing_preferences_autonomy()
		print("MECHANICS_RESULT ", JSON.stringify({"checks":checks,"failed":failures.size(),"failures":failures}))
		quit(0 if failures.is_empty() else 1)
		return
	if "--h04-only" in OS.get_cmdline_user_args():
		NpcLifeTests.new(self).h04_invitations_and_tenancy()
		print("MECHANICS_RESULT ", JSON.stringify({"checks":checks,"failed":failures.size(),"failures":failures}))
		quit(0 if failures.is_empty() else 1)
		return
	if "--npc-careers-only" in OS.get_cmdline_user_args():
		preload("res://tests/mechanics/npc_careers.gd").new(self).run()
		print("MECHANICS_RESULT ", JSON.stringify({"checks":checks,"failed":failures.size(),"failures":failures}))
		quit(0 if failures.is_empty() else 1)
		return
	if "--dialogue-only" in OS.get_cmdline_user_args():
		DialogueTests.new(self).run()
		print("MECHANICS_RESULT ", JSON.stringify({"checks": checks, "failed": failures.size(), "failures": failures}))
		quit(0 if failures.is_empty() else 1)
		return
	if "--personalities-only" in OS.get_cmdline_user_args():
		PersonalityTests.new(self).run()
		print("MECHANICS_RESULT ", JSON.stringify({"checks": checks, "failed": failures.size(), "failures": failures}))
		quit(0 if failures.is_empty() else 1)
		return
	if "--npc-life-only" in OS.get_cmdline_user_args():
		NpcLifeTests.new(self).run()
		print("MECHANICS_RESULT ", JSON.stringify({"checks": checks, "failed": failures.size(), "failures": failures}))
		quit(0 if failures.is_empty() else 1)
		return
	preload("res://tests/mechanics/depth.gd").new(self).run()
	_test_calendar_and_rules()
	_test_progression()
	_test_inventory_and_crafting()
	_test_economy()
	_test_social()
	_test_world_and_education()
	_test_organizations()
	_test_events_and_conditions()
	_test_encounters()
	_test_transactions_and_replay()
	_test_boundaries_and_validation()
	_test_housing_preferences_autonomy()
	if "--phase-profile" in OS.get_cmdline_user_args(): print("MECHANICS_PHASE advanced")
	AdvancedTests.new(self).run()
	ParityTests.new(self).run()
	BalanceTests.new(self).run()
	if "--phase-profile" in OS.get_cmdline_user_args(): print("MECHANICS_PHASE npc_life")
	NpcLifeTests.new(self).run()
	if "--phase-profile" in OS.get_cmdline_user_args(): print("MECHANICS_PHASE personality_dialogue")
	PersonalityTests.new(self).run()
	DialogueTests.new(self).run()
	if "--phase-profile" in OS.get_cmdline_user_args(): print("MECHANICS_PHASE family_digital")
	preload("res://tests/mechanics/family.gd").new(self).run()
	preload("res://tests/mechanics/family_handoff.gd").new(self).run()
	preload("res://tests/mechanics/digital.gd").new(self).run()
	preload("res://tests/mechanics/reproduction.gd").new(self).run()
	preload("res://tests/mechanics/pregnancy_wellbeing.gd").new(self).run()
	preload("res://tests/mechanics/adult_health.gd").new(self).run()
	preload("res://tests/mechanics/health_relationships.gd").new(self).run()
	preload("res://tests/mechanics/health_care_plans.gd").new(self).run()
	preload("res://tests/mechanics/care_access.gd").new(self).run()
	preload("res://tests/mechanics/care_homes.gd").new(self).run()
	preload("res://tests/mechanics/npc_planner.gd").new(self).run()
	preload("res://tests/mechanics/npc_reproduction.gd").new(self).run()
	if "--phase-profile" in OS.get_cmdline_user_args(): print("MECHANICS_PHASE integration")
	if not "--unit-only" in OS.get_cmdline_user_args(): _test_existing_integration()
	print("MECHANICS_RESULT ", JSON.stringify({"checks": checks, "failed": failures.size(), "failures": failures}))
	quit(0 if failures.is_empty() else 1)

func _test_calendar_and_rules() -> void:
	var epoch := Calendar.snapshot(0)
	_check(epoch.day == 12 and epoch.month_number == 4 and epoch.weekday == 7, "epoch retains April 12, Sunday")
	var may := Calendar.snapshot(19 * 1440)
	_check(may.day == 1 and may.month_number == 5, "calendar uses real April length")
	var year := Calendar.snapshot(264 * 1440)
	_check(year.year == 2027 and year.month_number == 1 and year.day == 1, "calendar crosses year")
	_check(Calendar.snapshot(300).phase == "dawn" and Calendar.snapshot(1320).phase == "night", "phase boundaries")
	_check(Rules.in_window(30, 1320, 120) and not Rules.in_window(120, 1320, 120), "overnight hours are half-open")
	_check(Rules.check({"x": 5}, {"all": [{"path": "x", "op": "gte", "value": 5}, {"not": {"path": "x", "value": 4}}]}), "nested predicates")
	_check(not Rules.check({}, {"path": "missing", "op": "gte", "value": 0}), "missing data does not satisfy numeric predicate")
	_check(Rules.check({"day": 1}, {"path": "day", "op": "in", "value": [1.0]}), "numeric membership survives JSON types")

func _test_progression() -> void:
	var sim = fresh()
	command(sim, "character", "gain_xp", {"amount": 230}) # 80 + 120 + 30 remainder.
	_check(sim.state.player.level == 3 and sim.state.player.xp == 30 and sim.state.player.points == 4, "multiple levels retain excess XP")
	command(sim, "character", "allocate", {"stat": "strength"})
	_check(sim.state.player.stats.strength == 6 and sim.state.player.points == 3, "allocate earned point")
	command(sim, "character", "perk", {"id": "quick_learner"})
	_check(not sim.command("character", "perk", {"id": "quick_learner"}).ok, "perk cannot be purchased twice")
	command(sim, "character", "effect", {"id": "focused"})
	_check(sim.services.character.effective_stat("intellect") == 8.0, "perk and effect combine without mutating base")
	command(sim, "clock", "advance", {"minutes": 120})
	_check(not sim.state.player.effects.has("focused") and sim.state.player.stats.intellect == 5, "effect expires at exact minute")
	_check(sim.state.player.needs.energy < 100 and sim.state.player.needs.satiety < 100, "elapsed time consumes needs")
	command(sim, "character", "rest", {"minutes": 60})
	_check(sim.state.player.needs.energy <= 100.0, "rest is bounded")
	for i in range(5): command(sim, "character", "substance", {"id": "stimulant"})
	command(sim, "clock", "advance", {"minutes": 1500})
	_check(sim.state.player.addictions.stimulant.exposure < 50, "withdrawal exposure decays with time")

func _test_inventory_and_crafting() -> void:
	var sim = fresh()
	command(sim, "inventory", "add", {"id": "jacket"})
	command(sim, "inventory", "equip", {"id": "jacket"})
	_check(sim.services.character.effective_stat("charisma") == 6.0, "equipment modifies effective stats")
	command(sim, "inventory", "remove", {"id": "jacket"})
	_check(sim.state.inventory.equipped.is_empty(), "removing last copy clears equipment slot")
	var before: Dictionary = sim.export_snapshot()
	_check(not sim.command("inventory", "add", {"id": "computer", "quantity": 100}).ok, "overweight addition rejected")
	_check(before == sim.export_snapshot(), "failed inventory operation preserves all state and RNG")
	command(sim, "inventory", "add", {"id": "stove"})
	command(sim, "world", "install", {"id": "stove"})
	command(sim, "inventory", "add", {"id": "grain"})
	command(sim, "inventory", "add", {"id": "vegetable"})
	var start := int(sim.state.clock.total_minutes)
	command(sim, "inventory", "craft", {"id": "vegetable_meal"})
	_check(sim.state.inventory.items.get("meal", 0) == 1 and not sim.state.inventory.items.has("grain"), "craft consumes ingredients and produces food")
	_check(sim.state.clock.total_minutes == start + 20 and sim.state.player.skills.cooking == 8, "craft advances time and skill")
	command(sim, "inventory", "use", {"id": "meal"})
	_check(not sim.state.inventory.items.has("meal") and sim.state.player.needs.satiety <= 100, "food consumed once and bounded")
	sim.state.world.location = "global_map"
	sim.state.clock = Calendar.snapshot(1440 + 600)
	command(sim, "inventory", "buy", {"id": "book", "shop": "market", "quantity": 2})
	_check(sim.state.economy.cash == 190 and sim.state.economy.shop_stock.market.book == 8, "shop purchase updates wallet and stock")
	command(sim, "inventory", "sell", {"id": "book", "shop": "market"})
	_check(sim.state.economy.cash == 205, "resale uses shop ratio")
	sim.state.clock = Calendar.snapshot(1440 + 1320)
	_check(not sim.command("inventory", "buy", {"id": "book", "shop": "market"}).ok, "shop rejects exact closing time")

func _test_economy() -> void:
	var sim = fresh()
	command(sim, "economy", "deposit", {"amount": 50})
	command(sim, "economy", "withdraw", {"amount": 20})
	_check(sim.state.economy.cash == 220 and sim.state.economy.bank == 30, "bank transfer conserves money")
	_check(not sim.command("economy", "deposit", {"amount": -10}).ok, "negative transfer rejected")
	command(sim, "economy", "borrow", {"amount": 100})
	command(sim, "economy", "repay", {"amount": 100})
	_check(sim.state.economy.debt == 0, "credit repayment")
	command(sim, "economy", "buy_asset", {"id": "studio"})
	command(sim, "clock", "advance", {"minutes": 13})
	_check(sim.state.economy.bank >= 48, "asset income paid at next midnight")
	command(sim, "inventory", "add", {"id": "computer"})
	command(sim, "world", "install", {"id": "computer"})
	for i in range(3): command(sim, "economy", "work", {"id": "freelance"})
	_check(not sim.command("economy", "work", {"id": "freelance"}).ok, "work daily limit")
	command(sim, "clock", "advance", {"minutes": 1440})
	command(sim, "economy", "work", {"id": "freelance"})
	command(sim, "economy", "project", {"id": "website_order", "minutes": 60})
	command(sim, "economy", "project", {"id": "website_order", "minutes": 60})
	_check(sim.state.economy.projects.website_order.completed, "multi-session digital project completion")
	_check(not sim.command("economy", "project", {"id": "website_order"}).ok, "project cannot pay twice")
	command(sim, "economy", "stream", {"minutes": 30})
	_check(sim.state.economy.channel.followers > 0, "stream grows channel")

func _test_social() -> void:
	var sim = fresh()
	command(sim, "social", "generate", {"id": "colleague", "name": "Colleague"})
	command(sim, "social", "generate", {"id": "neighbor"})
	_check(not sim.command("social", "generate", {"id": "colleague"}).ok, "NPC IDs stay unique")
	command(sim, "social", "interact", {"id": "colleague", "action": "talk"})
	_check(sim.state.social.npcs.colleague.memories.size() == 1, "interaction recorded in memory")
	command(sim, "inventory", "add", {"id": "book"})
	command(sim, "social", "gift", {"id": "colleague", "item": "book"})
	_check(sim.state.social.npcs.colleague.inventory.book == 1 and not sim.state.inventory.items.has("book"), "gift moves ownership")
	command(sim, "social", "relationship", {"id": "colleague", "other": "neighbor", "changes": {"trust": 500}})
	_check(sim.services.social.relationship("neighbor", "colleague").trust == 100, "social graph is symmetric and bounded")
	_check(not sim.command("social", "message", {"id": "colleague", "text": "Hello"}).ok, "phone requires contact")
	command(sim, "social", "contact", {"id": "colleague"})
	command(sim, "social", "message", {"id": "colleague", "text": "Hello"})
	command(sim, "social", "read", {"id": "colleague"})
	_check(sim.state.social.messages[0].read, "message marked read")
	var due := int(sim.state.clock.total_minutes) + 10
	command(sim, "social", "appointment", {"id": "colleague", "minute": due, "location": "bedroom"})
	command(sim, "clock", "advance", {"minutes": 10})
	_check(sim.state.social.appointments[0].status == "met", "appointment resolves at meeting place")
	due = int(sim.state.clock.total_minutes) + 10
	command(sim, "social", "appointment", {"id": "neighbor", "minute": due, "location": "global_map"})
	command(sim, "clock", "advance", {"minutes": 40})
	_check(sim.state.social.appointments[1].status == "missed", "absent appointment fails after grace period")

func _test_world_and_education() -> void:
	var sim = fresh()
	command(sim, "world", "travel", {"id": "apartment_hall"})
	_check(sim.state.clock.total_minutes == 1428 and sim.state.world.previous_location == "bedroom", "travel follows route and spends minutes")
	_check(not sim.command("world", "travel", {"id": "training_center"}).ok, "no direct route rejected")
	command(sim, "world", "shower")
	command(sim, "world", "clean")
	command(sim, "world", "homework")
	_check(sim.state.world.cleanliness <= 100 and sim.state.world.education.homework, "domestic and homework actions")
	sim.state.clock = Calendar.snapshot(1440 + 480)
	sim.state.world.location = "training_center"
	command(sim, "world", "lesson", {"id": "computing_class"})
	_check(sim.state.world.education.grade >= 3 and sim.state.player.skills.computing == 25, "lesson advances grade and skill")
	_check(not sim.command("world", "lesson", {"id": "computing_class"}).ok, "lesson cannot repeat on same day")
	command(sim, "social", "generate", {"id": "worker"})
	_check(sim.state.social.npcs.worker.location == "training_center", "weekday NPC schedule")
	command(sim, "clock", "advance", {"minutes": 7 * 60})
	_check(sim.state.social.npcs.worker.location == "global_map", "NPC moves to afternoon activity")
	_check(sim.state.world.weather in sim.catalog.settings.weather_types, "weather belongs to configured set")

