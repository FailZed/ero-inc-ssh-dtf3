func _test_events_and_conditions() -> void:
	var sim = fresh()
	command(sim, "events", "start_quest", {"id": "first_steps"})
	command(sim, "events", "progress", {"id": "first_steps", "objective": "practice"})
	command(sim, "events", "progress", {"id": "first_steps", "objective": "practice"})
	_check(sim.state.journal.quests.first_steps.status == "completed", "objective completes quest")
	command(sim, "events", "claim_quest", {"id": "first_steps"})
	_check(not sim.command("events", "claim_quest", {"id": "first_steps"}).ok, "quest reward exactly once")
	sim.state.clock = Calendar.snapshot(1080)
	command(sim, "events", "poll")
	_check("first_evening" in sim.state.journal.ready_events, "eligible event enters queue")
	command(sim, "events", "fire", {"id": "first_evening"})
	_check(sim.state.world.flags.evening_seen and not sim.command("events", "fire", {"id": "first_evening"}).ok, "one-shot event applies flag once")
	command(sim, "character", "gain_xp", {"amount": 100})
	command(sim, "events", "claim_achievement", {"id": "first_level"})
	_check("milestone_first_level" in sim.state.world.unlocked, "achievement unlocks gallery token")
	command(sim, "lifecycle", "start", {"id": "recovery"})
	command(sim, "clock", "advance", {"minutes": 1440})
	_check(sim.state.conditions["player:recovery"].status == "completed" and sim.state.conditions["player:recovery"].stage == 2, "long condition advances stages and completes")
	var timeout = fresh()
	command(timeout, "events", "start_quest", {"id": "first_steps"})
	command(timeout, "clock", "advance", {"minutes": 2880})
	_check(timeout.state.journal.quests.first_steps.status == "failed", "quest deadline not skipped by fast-forward")

func _test_encounters() -> void:
	var sim = fresh()
	command(sim, "social", "generate", {"id": "opponent"})
	command(sim, "encounters", "combat_start", {"npc": "opponent"})
	command(sim, "encounters", "combat_action", {"action": "end_turn"})
	for response in range(4):
		if sim.state.encounters.combat.phase != "defence": break
		command(sim,"encounters","combat_action",{"action":"guard"})
	_check(sim.state.encounters.combat.turn == 2 and sim.state.encounters.combat.ap == 4, "combat turn restores AP and resolves defense")
	_check(not sim.command("encounters", "combat_action", {"part": "unknown"}).ok, "unknown hit zone rejected")
	_check(not sim.command("character", "rest", {"minutes": 60}).ok, "combat cannot be bypassed with rest")
	while sim.state.encounters.combat.status == "active":
		command(sim, "encounters", "combat_action", {"action": "guard" if sim.state.encounters.combat.phase == "defence" else "escape"})
	_check(sim.services.encounters.score([1, 1, 9]) == 21, "blackjack handles multiple aces")
	command(sim, "encounters", "game_start", {"type": "blackjack", "stake": 10})
	command(sim, "encounters", "game_input", {"action": "stand"})
	_check(sim.state.encounters.game.status != "active", "blackjack settles hand")
	_check(not sim.command("encounters", "game_input", {"action": "stand"}).ok, "settled hand cannot pay twice")
	command(sim, "encounters", "game_start", {"type": "reaction"})
	command(sim, "encounters", "game_input", {"value": sim.state.encounters.game.target})
	_check(sim.state.encounters.game.status == "won", "reaction game resolves valid target")
	command(sim, "encounters", "game_start", {"type": "guess"})
	command(sim, "encounters", "game_input", {"value": sim.state.encounters.game.secret})
	_check(sim.state.encounters.game.status == "won", "guess game resolves correct choice")
	command(sim, "encounters", "game_start", {"type": "lockpick"})
	for i in range(3): command(sim, "encounters", "game_input", {"value": sim.state.encounters.game.pins[i]})
	_check(sim.state.encounters.game.status == "won", "lockpick requires all pins")
	command(sim, "encounters", "game_start", {"type": "strength"})
	for i in range(5):
		if sim.state.encounters.game.status == "active": command(sim, "encounters", "game_input", {"value": 1.0})
	_check(sim.state.encounters.game.status == "won", "strength challenge accumulates effort")
	command(sim, "encounters", "steal", {"npc": "opponent"})
	_check(sim.state.world.heat >= 0 and sim.state.social.npcs.opponent.money >= 0, "crime preserves non-negative state")

func _test_transactions_and_replay() -> void:
	var sim = fresh({"actions": {"broken": {"costs": {"economy.cash": 10}, "effects": [{"kind": "item", "id": "unknown", "amount": 1}]}}})
	sim.state.clock = Calendar.snapshot(480)
	var before: Dictionary = sim.export_snapshot()
	_check(not sim.command("actions", "perform", {"id": "broken"}).ok, "invalid action effect rejected")
	_check(sim.export_snapshot() == before, "failed action rolls back resource costs and counters")
	var random_failure = fresh({"actions": {"random_failure": {"effects": [
		{"kind": "command", "module": "encounters", "operation": "game_start", "args": {"type": "reaction", "stake": 10}},
		{"kind": "item", "id": "missing", "amount": 1}]}}})
	var random_before: Dictionary = random_failure.export_snapshot()
	_check(not random_failure.command("actions", "perform", {"id": "random_failure"}).ok and random_failure.export_snapshot() == random_before, "rollback restores RNG after random work and a later failure")
	command(sim, "actions", "perform", {"id": "exercise"})
	_check(sim.state.player.skills.fighting == 10, "declarative action executes skill reward")
	for i in range(3): command(sim, "actions", "perform", {"id": "exercise"})
	_check(not sim.command("actions", "perform", {"id": "exercise"}).ok, "action daily limit")
	var serialized: Dictionary = JSON.parse_string(JSON.stringify(sim.export_snapshot()))
	var replay = fresh({"actions": {"broken": {"costs": {"economy.cash": 10}, "effects": [{"kind": "item", "id": "unknown", "amount": 1}]}}})
	_check(replay.restore_snapshot(serialized).ok, "snapshot restores through JSON roundtrip")
	command(sim, "social", "generate", {"id": "deterministic"})
	command(replay, "social", "generate", {"id": "deterministic"})
	_check(JSON.parse_string(JSON.stringify(sim.export_snapshot())) == JSON.parse_string(JSON.stringify(replay.export_snapshot())), "restored RNG reproduces NPC and state")
	var invalid := serialized.duplicate(true)
	invalid.state.player.needs.energy = -1
	var replay_before: Dictionary = replay.export_snapshot()
	_check(not replay.restore_snapshot(invalid).ok and replay.export_snapshot() == replay_before, "invalid snapshot leaves current state intact")
	var bulk = fresh()
	var incremental = fresh()
	command(bulk, "clock", "advance", {"minutes": 180})
	for i in range(180): incremental.command("clock", "advance", {"minutes": 1})
	_check(bulk.export_snapshot() == incremental.export_snapshot(), "fast-forward equals minute-by-minute simulation")
	_check(not bulk.command("clock", "advance", {"minutes": -1}).ok, "backwards simulation rejected")

func _test_boundaries_and_validation() -> void:
	var sim = fresh()
	var snapshot: Dictionary = sim.export_snapshot()
	var invalid := snapshot.duplicate(true)
	invalid.state.player.effects = []
	_check(not sim.restore_snapshot(invalid).ok, "wrong effect container rejected before restore")
	invalid = snapshot.duplicate(true)
	invalid.state.world.education = {}
	_check(not sim.restore_snapshot(invalid).ok, "truncated education snapshot rejected")
	_check(not sim.command("social", "relationship", {"id": "x", "changes": []}).ok, "malformed arguments rejected at command boundary")
	_check(not sim.command("clock", "advance", {"minutes": 1.5}).ok, "fractional action time rejected")
	var bad = fresh({"actions": {"negative_cost": {"costs": {"economy.cash": -1}}}})
	_check(not bad.configuration_error.is_empty() and not bad.command("actions", "perform", {"id": "negative_cost"}).ok, "invalid content costs cannot create money")
	command(sim, "clock", "advance", {"minutes": 13})
	_check(sim.state.world.education.absences == 0, "late-night session does not punish lessons that ended before start")
	command(sim, "clock", "advance", {"minutes": 720})
	_check(sim.state.world.education.absences == 1, "unattended weekday lesson penalized at closing minute")
	var controller := QuestInventory.new()
	root.add_child(controller)
	controller.bind(sim)
	controller.give_item("book", 2)
	_check(controller.check_item("book", 2), "Quest Weaver inventory contract counts received items")
	_check(controller.take_item("book", 1) and controller.count_item("book") == 1, "Quest Weaver inventory contract consumes exact amount")
	_check(not controller.take_item("book", 2) and controller.count_item("book") == 1, "Quest Weaver rejects taking missing quantity atomically")
	controller.bind(null)
	controller.free()
	var stress = fresh()
	for i in range(100):
		var result: Dictionary = stress.command("social", "generate")
		if not result.ok: _check(false, "stress NPC generation")
	var started := Time.get_ticks_msec()
	command(stress, "clock", "advance", {"minutes": 7 * 1440})
	_check(stress.state.social.npcs.size() == 100 and stress.state.clock.total_minutes == 1427 + 7 * 1440, "100 NPCs survive week-long simulation")
	print("MECHANICS_BENCHMARK ", JSON.stringify({"npcs": 100, "days": 7, "milliseconds": Time.get_ticks_msec() - started}))

func _test_housing_preferences_autonomy() -> void:
	var sim = fresh({"settings": {"start_cash": 5000}})
	command(sim, "housing", "buy", {"id": "apartment"})
	command(sim, "housing", "move_in", {"id": "apartment"})
	_check(sim.state.housing.residence == "apartment" and sim.state.economy.cash == 3500, "property purchase charges exactly once")
	command(sim, "inventory", "add", {"id": "stove"})
	command(sim, "housing", "furnish", {"id": "apartment", "item": "stove"})
	_check("stove" in sim.state.world.equipment and not sim.state.inventory.items.has("stove"), "furnishing transfers item to residence")
	command(sim, "social", "generate", {"id": "tenant"})
	sim.state.social.npcs.tenant.inventory.meal = 100 # Keep this fixture focused on rent rather than NPC food spending.
	command(sim, "housing", "tenant", {"id": "apartment", "npc": "tenant"})
	_check(not sim.command("housing", "sell", {"id": "apartment"}).ok, "occupied property sale requires tenant handling")
	command(sim, "clock", "advance", {"minutes": 30 * 1440})
	_check(sim.state.economy.bank == 100 and sim.state.social.npcs.tenant.money == 0, "monthly rent transfers tenant funds to landlord")
	command(sim, "housing", "remove_tenant", {"id": "apartment", "npc": "tenant"})
	command(sim, "housing", "sell", {"id": "apartment"})
	_check(sim.state.housing.properties.is_empty() and sim.state.housing.residence == "", "property sale clears ownership and residence")
	var rented = fresh()
	command(rented, "housing", "rent", {"id": "apartment"})
	command(rented, "clock", "advance", {"minutes": 30 * 1440})
	_check(rented.state.housing.properties.apartment.arrears == 180, "insufficient monthly rent becomes explicit arrears")
	_check(not rented.command("housing", "end_lease", {"id": "apartment"}).ok, "unpaid lease cannot silently disappear")
	command(rented, "economy", "borrow", {"amount": 200})
	command(rented, "housing", "pay_arrears", {"id": "apartment"})
	command(rented, "housing", "end_lease", {"id": "apartment"})
	var january31 := Calendar.snapshot(294 * 1440)
	_check(january31.month_number == 1 and january31.day == 31, "monthly payment test starts at January 31")
	var february := Calendar.snapshot(Calendar.add_months(294 * 1440, 1))
	_check(february.month_number == 2 and february.day == 28, "monthly due date clamps to February end")
	var easy = fresh()
	var hard = fresh()
	command(easy, "preferences", "difficulty", {"id": "easy"})
	command(hard, "preferences", "difficulty", {"id": "hard"})
	command(easy, "actions", "perform", {"id": "exercise"})
	command(hard, "actions", "perform", {"id": "exercise"})
	_check(easy.state.player.needs.energy > hard.state.player.needs.energy and easy.state.player.xp > hard.state.player.xp, "difficulty consistently changes resource use and XP")
	var filtered = fresh({"actions": {"restricted": {"tags": ["test_category"], "minutes": 1}}})
	command(filtered, "preferences", "content_tag", {"id": "test_category", "enabled": false})
	_check(not filtered.command("actions", "perform", {"id": "restricted"}).ok, "content filter blocks tagged action")
	command(filtered, "preferences", "content_tag", {"id": "test_category", "enabled": true})
	command(filtered, "actions", "perform", {"id": "restricted"})
	var failed_cook = fresh({"recipes": {"failure_case": {"ingredients": {"grain": 1}, "outputs": {"meal": 1}, "success_chance": 0.0, "skill": "cooking", "xp": 8, "minutes": 10}}})
	command(failed_cook, "inventory", "add", {"id": "grain"})
	var result := command(failed_cook, "inventory", "craft", {"id": "failure_case"})
	_check(not result.data.crafted and not failed_cook.state.inventory.items.has("meal") and failed_cook.state.player.skills.cooking == 4, "failed cooking consumes effort and teaches skill without granting output")
	var graph = fresh()
	command(graph, "social", "generate", {"id": "a"})
	command(graph, "social", "generate", {"id": "b"})
	_check(not graph.state.social.npcs.a.biography.is_empty(), "NPC generation includes biography facts")
	command(graph, "social", "relationship", {"id": "a", "other": "b", "changes": {"trust": 35, "affinity": 35, "attraction": 45}})
	command(graph, "clock", "advance", {"minutes": 1440})
	_check(graph.services.social.relationship("a", "b").status == "partner", "autonomous social graph forms eligible relationship")
	_check(graph.state.social.npcs.a.skills.get("study", 0) > 0, "NPC autonomous activity develops skills")
	var chain = fresh({"actions": {"recover": {"effects": [{"kind": "condition", "id": "recovery"}, {"kind": "command", "module": "character", "operation": "gain_xp", "args": {"amount": 5}}]}}})
	command(chain, "actions", "perform", {"id": "recover"})
	_check(chain.state.conditions.has("player:recovery") and chain.state.player.xp == 5, "declarative action can orchestrate modules in one transaction")

func _test_existing_integration() -> void:
	var session := root.get_node("GameSession")
	var locations := root.get_node("LocationManager")
	var original_time: Dictionary = session.get_game_time_snapshot()
	var dialogic = root.get_node("Dialogic")
	var variables = dialogic.get_subsystem("VAR")
	var counters := {"hours": 0, "days": 0}
	var hour_callback := func(_snapshot): counters.hours += 1
	var day_callback := func(_snapshot): counters.days += 1
	session.game_hour_changed.connect(hour_callback)
	session.game_day_changed.connect(day_callback)
	session.set_game_time_total_minutes(1427)
	variables.var_storage["World"]["preservation_probe"] = 7
	session.advance_game_time(133)
	_check(variables.var_storage["World"].get("preservation_probe") == 7, "clock synchronization preserves other World data")
	variables.var_storage["World"].erase("preservation_probe")
	_check(counters.hours == 3 and counters.days == 1, "existing clock reports all crossed hour and day boundaries")
	session.game_hour_changed.disconnect(hour_callback)
	session.game_day_changed.disconnect(day_callback)
	session.acquire_game_time_lock(&"test_a")
	session.acquire_game_time_lock(&"test_b")
	session.release_game_time_lock(&"test_a")
	_check(session.is_game_time_blocked(), "independent time lock owners")
	session.release_game_time_lock(&"test_b")
	_check(not session.is_game_time_blocked(), "last owner releases time")
	_check(not session.set_game_time_mode("bad"), "unknown time mode rejected")
	var adapter := Adapter.new()
	var original_mode: String = session.get_game_time_mode()
	root.add_child(adapter)
	adapter.attach(session, locations)
	var start := int(session.get_game_time_snapshot().total_minutes)
	var result: Dictionary = adapter.execute("actions", "perform", {"id": "exercise"})
	_check(result.ok and session.get_game_time_snapshot().total_minutes == start + 30, "adapter advances main clock exactly once")
	session.advance_game_time(5)
	_check(adapter.simulation.state.clock.total_minutes == start + 35, "external action time updates simulation")
	_check(adapter.simulation.state.player.stats.strength == session.get_character_profile().stats.strength, "adapter imports existing character")
	adapter.detach()
	adapter.free()
	_check(session.get_game_time_mode() == original_mode, "adapter restores previous time policy on detach")
	_check(not locations.can_go_to("unknown").ok, "existing location API gives reason for missing location")
	var registry: Dictionary = locations.get_locations()
	registry.clear()
	_check(not locations.get_locations().is_empty(), "location registry query returns independent copy")
	session.set_game_time_total_minutes(int(original_time.total_minutes))
