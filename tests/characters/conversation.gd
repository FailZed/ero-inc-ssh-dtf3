extends RefCounted
const Factory = preload("res://scripts/mechanics/conversation_room.gd")
const Actor = preload("res://scripts/characters/conversation_actor.gd")
var t

func _init(runner) -> void:
	t = runner

func run() -> void:
	var demo := Factory.create()
	t.check(demo.get("ok",false),"conversation room prepares the actual NPC runtime")
	if not demo.get("ok",false): return
	var session: RefCounted = demo.session
	t.check(session.sim.configuration_error.is_empty(),"dialogue catalog is valid")
	t.check(session.actor().name == "Ника" and session.actor().age == 24,"original adult room resident")
	t.check(session.open().ok,"conversation opens")
	var initial: Dictionary = session.present()
	t.check(not str(initial.utterance.text).is_empty() and initial.choices.size()>3,"actual contextual greeting and choices")
	var snapshot: Dictionary = session.sim.export_snapshot()
	session.present()
	session.bond()
	t.check(session.sim.export_snapshot()==snapshot,"presenting dialogue is read only")
	var minute := int(session.sim.state.clock.total_minutes)
	t.check(session.choose("day",int(initial.turn)).ok,"topic can be selected")
	t.check(int(session.sim.state.clock.total_minutes)==minute+3,"conversation consumes time once")
	var after: Dictionary = session.sim.export_snapshot()
	t.check(not session.choose("day",int(initial.turn)).ok and session.sim.export_snapshot()==after,"stale turn cannot duplicate consequences")
	t.check(session.transcript.size()==3 and session.transcript[1].speaker == "player","transcript includes both sides once")
	var turn := int(session.present().turn)
	t.check(session.choose("encourage",turn).get("ok",false),"support action uses existing relationship rules")
	t.check(session.present().has("utterance"),"relationship response becomes NPC speech")
	session.close()
	t.check(not session.active and session.present().is_empty(),"close ends the authoritative conversation")
	var fresh := Factory.create()
	t.check(int(fresh.simulation.state.clock.total_minutes)==int(fresh.config.start_minutes),"new room has independent state")
	var actor := Actor.new()
	t.root.add_child(actor)
	actor.size = Vector2(600,600)
	actor.set_process(false)
	t.check(actor.load_reactions(),"conversation Live2D model loads")
	t.check(float(actor.bank.values.ParamShirtEnabled)==1.0,"speaking character starts clothed")
	actor.present_line("Привет, рада тебя видеть!","smile")
	actor._process(0.1)
	t.check(actor.speaking and actor.revealed>0 and actor.revealed<actor.speech_text.length(),"text-paced speech reveal")
	t.check(float(actor.bank.target_for("ParamMouthOpen"))>0.0,"mouth follows text reveal")
	t.check(is_equal_approx(float(actor.bank.target_for("ParamMouthForm")),0.65),"smile maps to native model parameters")
	actor.finish_speech()
	t.check(not actor.speaking and not actor.bank.channels.has("speech"),"skip finishes text and releases mouth")
	actor.gesture("nod")
	actor._process(0.1)
	t.check(actor.bank.channels.has("dialogue_gesture"),"short reaction gesture begins")
	actor._process(1.0)
	t.check(not actor.bank.channels.has("dialogue_gesture"),"gesture returns control to pose")
	t.check(not actor.set_expression("missing") and actor.expression=="smile","unknown expression is rejected without substituting another pose")
	actor.present_line("Пауза.")
	actor.cancel_speech()
	t.check(not actor.speaking and not actor.bank.channels.has("speech"),"close cancels ongoing speech")
	actor.present_line("Описание события.","concern",false,true)
	actor._process(0.1)
	t.check(actor.speaking and not actor.bank.channels.has("speech"),"narration reveals text without moving the character mouth")
	actor.free()
	var screen := load("res://scenes/characters/conversation_room.tscn").instantiate() as Control
	t.root.add_child(screen)
	await t.process_frame
	t.check(is_instance_valid(screen.puppet.model),"visible room contains a real Live2D model")
	t.check(screen._text.text==screen.session.present().utterance.text,"screen shows authoritative NPC reply")
	t.check(screen._tab_buttons.size()==7,"seven conversation categories are present")
	var icon_tabs := true
	for button: Button in screen._tab_buttons.values(): icon_tabs = icon_tabs and button.text.is_empty() and button.icon != null and not button.tooltip_text.is_empty()
	t.check(icon_tabs,"category tabs use icons with accessible titles")
	var matrix_before: Dictionary = screen.session.sim.export_snapshot()
	screen._show_matrix()
	t.check(is_instance_valid(screen._matrix_overlay) and screen.session.sim.export_snapshot()==matrix_before,"opening the relationship matrix is read only")
	screen._close_matrix()
	t.check(not is_instance_valid(screen._matrix_overlay),"matrix closes without ending the conversation")
	screen._select_tab("intimacy")
	var blank_found := false
	for child: Node in screen._options.get_children():
		if child is Control and not child is Button and child.custom_minimum_size.y>=180: blank_found = child.mouse_filter==Control.MOUSE_FILTER_IGNORE
	t.check(blank_found,"reserved visual spacing is inert")
	screen._select_tab("dialogue")
	t.check(not screen._buttons[0].disabled,"menu remains usable while a greeting appears")
	screen.puppet.finish_speech()
	t.check(not screen._buttons[0].disabled,"skip enables current choices")
	var rendered: Dictionary = screen.session.present()
	var navigation_before: Dictionary = screen.session.sim.export_snapshot()
	screen._select_tab("actions")
	screen._select_tab("dialogue")
	screen._open_folder("Повседневные темы")
	t.check(screen.session.sim.export_snapshot()==navigation_before,"categories and folders consume no world time or state")
	t.check(screen._submenu.visible,"nested topics open beside the current menu")
	screen._choose("day",int(rendered.turn))
	t.check(screen.session.present().node=="day" and screen._text.text==screen.session.present().utterance.text,"screen topic choice advances actual dialogue")
	t.check(screen._reply_mode and not screen._menu_area.visible,"reply phase gives the scene room")
	screen.puppet.finish_speech()
	screen._advance()
	t.check(not screen._reply_mode and screen._submenu.visible and screen._folder=="Повседневные темы","continue returns to the same category and folder")
	screen.session.sim.catalog.conversation_options.ac_silent.certain = true
	screen._choose("ac_silent",int(screen.session.present().turn))
	t.check(screen._speaker.text=="Результат" and screen.session.present().utterance.get("narrated",false),"descriptive activity outcome is separated from NPC speech")
	var stale := int(rendered.turn)
	var state: Dictionary = screen.session.sim.export_snapshot()
	screen._choose("day",stale)
	t.check(screen.session.sim.export_snapshot()==state,"double input does not repeat action")
	screen._restart()
	t.check(screen.session.transcript.size()==1 and screen.session.present().node=="root","restart clears this room only")
	screen.puppet.present_line("Незаконченная реплика.")
	var weak: WeakRef = weakref(screen.puppet)
	screen.queue_free()
	await t.process_frame
	t.check(weak.get_ref()==null,"closing room frees the talking model")
