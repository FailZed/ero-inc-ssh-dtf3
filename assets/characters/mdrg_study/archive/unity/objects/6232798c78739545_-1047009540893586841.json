    {
      "m_Id": 209124748665282560,
      "m_Localized": "Skatieties ziņas ar {f_botName}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 8363390524344257483
          },
          {
            "rid": 7996671569124655530
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "Kādu lielvaru jūs vēlētos?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655531
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "Vēl viens šausmu stāsts",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655532
          }
        ]
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "Ko jūs darāt, kad esmu ārpus mājas?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655533
          }
        ]
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "Ja jūs varētu dabūt darbu, kāds tas būtu?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655534
          }
        ]
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "Vai jūs vēlētos kļūt par cilvēku?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655535
          }
        ]
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "Atriebība saimniekam",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655536
          }
        ]
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "Pajautājiet viņai, kā tikt galā ar problemātisko kaimiņu",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655537
          }
        ]
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "Kas, jūsuprāt, notiek pēc nāves?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655538
          }
        ]
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "Vai jums ir plāns zombiju apokalipses gadījumam?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655539
          }
        ]
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "Izmēģināsim lomu spēli",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655540
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Vai Annalija kādreiz atradīs sev draugu?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655541
          }
        ]
      }
    }
  ],
