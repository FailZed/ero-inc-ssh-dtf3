    {
      "m_Id": 208135514265477120,
      "m_Localized": "계산원에게 어떻게 해야하는지 물어보기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655108
          }
        ]
      }
    },
    {
      "m_Id": 208136759931822080,
      "m_Localized": "그녀에게 말을 다시 걸어보기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655109
          }
        ]
      }
    },
    {
      "m_Id": 208176712170594304,
      "m_Localized": "멜리사와 그녀의 '잃어버린' 부품에 대해 묻기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655110
          }
        ]
      }
    },
    {
      "m_Id": 208184189855457280,
      "m_Localized": "봇에 대한 노숙자의 생각에 대해 의논하기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655111
          }
        ]
      }
    },
    {
      "m_Id": 208249514085048320,
      "m_Localized": "수리 후 기분이 어떤지에 대해 묻기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655112
          }
        ]
      }
    },
    {
      "m_Id": 209124748665282560,
      "m_Localized": "{f_botName}와 함께 뉴스 시청하기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 6437392580223180673
          },
          {
            "rid": 7996671569124655113
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "어떤 초능력을 얻고 싶은지 물어보기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655114
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "또 다른 공포 이야기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655115
          }
        ]
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "내가 집에 없을 때 뭐하니?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655116
          }
        ]
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "직업을 갖는다면, 어떤 일을 하고 싶니?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655117
          }
        ]
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "인간으로 변하고 싶지 않니?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655118
          }
        ]
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "집주인에게  복수하기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655119
          }
        ]
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "문제인 이웃을 어떻게 할지 물어보기",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655120
          }
        ]
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "사후엔 뭔 일이 있을까?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655121
          }
        ]
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "좀비 아포칼립스에 대비해둔게 있나?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655122
          }
        ]
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "롤플레잉 하자",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655123
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Annie가 남자친구를 찾을 수 있을까요?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655124
          }
        ]
      }
    }
  ],
