      },
      {
        "rid": 7996671569124131354,
        "type": {
          "class": "Comment",
          "ns": "UnityEngine.Localization.Metadata",
          "asm": "Unity.Localization"
        },
        "data": {
          "m_CommentText": "(demonikku): deixasse apenas apresentador, menos extenso e autoexplicativo pra(s) cena(s) deste personagem"
