  "m_TableData": [
    {
      "m_Id": 3183073955840,
      "m_Localized": "Prova a dire il suo nome",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "Parlale",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "Prova a chiamarla",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "Prova a parlarle",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "Di' ciao",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "Sento uno strano bisogno di parlarle",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "Parliamole",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "Dove la nascondo",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "Diamo un'occhiata al bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "Prova a comunicare",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "Riguardo il mio affitto?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "Sono preoccupato...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "Che cos'era?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "Quanto vale?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "La mia vita sessuale",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "Parla al bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Parla al bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Parla al bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Chiedile riguardo a dove vivo",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Mi chiedo cosa ne pensa di me...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Forse è brava in matematica...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Chiedile come fare soldi facili",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Chiedile il meteo",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Chiedile cosa pensa delle dimensioni del mio...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Che mi dici di quella cosa del caffè",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Mi fa innervosire...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Che fastidio...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Proviamo a parlarle",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Fai una chiacchierata",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Parlale",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Dille di parlarti",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Chiedile di parlare più dolcemente",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Sono annoiato...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Passiamo un pò di tempo con lei",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Parliamo!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Poni al bot alcune somande esistenziali",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Chiedile qualcosa di irrilevante",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Chiedile di politica",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Chiedile la fonte di ogni sofferenza",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Sono dell'umore giusto per fare un gioco",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Giochiamo a carte",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "è tempo per \"catena di parole\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "È un po' tardi ma mi piacerebbe parlare ancora con lei",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "Penso che il bot voglia parlare...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Dille che la ami!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Flirta con bot <3",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Dovrei essere più gentile con lei...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Chiedile riguardo le sue emozoni",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "Un sexbot ha degli interessi?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733102,
      "m_Localized": "Un sexbot ha mai fame?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733103,
      "m_Localized": "Voglio toccarla...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733104,
      "m_Localized": "Ho dimenticato qualcosa?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733105,
      "m_Localized": "Riguardo il livello di intelligenza del bot...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733106,
      "m_Localized": "Può un bot giocare a scacchi?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733107,
      "m_Localized": "Forse dovrei provare un altro gioco?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733108,
      "m_Localized": "Penso di sapere a quale gioco posso batterla...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733109,
      "m_Localized": "Il bot sembra strano...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733110,
      "m_Localized": "Mi chiedo come si senta riguardo me...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733111,
      "m_Localized": "Il bot sembra immerso in pensieri profondi...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733112,
      "m_Localized": "Credo che voglia qualcosa da me",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733113,
      "m_Localized": "Adesso che ha entrambe le gambe...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733114,
      "m_Localized": "Dovrei chiedere al bot riguardo il rischio di uscire",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733115,
      "m_Localized": "Devo chiederle riguardo le possibilita per lei di uscire",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733116,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733117,
      "m_Localized": "Riguardo al sexbot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733118,
      "m_Localized": "Forse può parlare dopotutto?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733119,
      "m_Localized": "Parlale ancora",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733120,
      "m_Localized": "Qualcosa non va...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186710323200,
      "m_Localized": "Cosa ne pensa degli animali domestici?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906112,
      "m_Localized": "Dovrei invitarla ad un appuntamento",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906113,
      "m_Localized": "Voglio vedere un film con lei",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153391337472,
      "m_Localized": "Cos'è questo strano odore?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503296,
      "m_Localized": "Chiedi delle decorazioni di Halloween",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503297,
      "m_Localized": "Che ne dici di quel simpatico peluche ragno?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 120816570795429888,
      "m_Localized": "Dovrei chiederle se Shanice può venire da me",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 121488171031465984,
      "m_Localized": "Che ne dici del karaoke?",
