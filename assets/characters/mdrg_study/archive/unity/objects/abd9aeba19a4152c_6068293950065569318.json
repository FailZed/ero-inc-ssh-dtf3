    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Promluv s botem",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Zeptej se jí na svůj pokoj",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Zajímá mě, co si o mně myslí...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Možná umí počítat?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Zeptej se jí, jak na rychlý prachy",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Zeptej se jí na počasí",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Zeptej se jí, co si myslím o délce tvého...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "A co ta věc s kávou",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Nasírá mě...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Je otravná...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Zkusme si sní promluvit",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Prohoďte malou řeč ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Mluv s ní",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Řekni jí, aby s tebou mluvila",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Zeptej se jí, aby mluvila jemně",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Jsem znuděný...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Pojďme s ní ztrávit trochu času",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Pojďme pokecat!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Zeptej se bota na existenční otázky ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Zeptej se jí na něco nedůležitého",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Zeptej se ji na politiku",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Zeptej se jí na zdroj všeho trápení ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Mám náladu si něco zahrát",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Pojďme si zahrát karty",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Čas na slovní řetěz!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Je trochu pozdě, ale chci s ní promluvit",
