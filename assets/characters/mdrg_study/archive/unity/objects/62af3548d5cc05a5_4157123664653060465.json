      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Makipag-usap sa bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Makipag-usap sa bot",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Tanungin mo siya tungkol sa kwarto ko",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Ano kaya ang tigin nya sakin",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Baka marunong siyang mag math?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Tanungin mo sya kung paano kumita ng mabilis",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Tanungin mo sya tungkol sa lagay ng panahon",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Tanungin mo sya kung ano ang iniisip nya tungkol sa laki ng aking...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Paano naman ung nangyayari sa kape",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Nakakainis sya...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Nakakayamot sya...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Subukan natin siyang kausapin",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Magkaroon ng maikling usapan",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Kausapin mo sya",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Sabihin mo sa kanya na makipag-usap sa iyo",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Hilingin sa kanya na magsalita nang malumanay",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Naiinip ako…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Gumugol tayo ng ilang oras sa kanya",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Mag-chat tayo!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Magtanong sa bot ng ilang eksistensyal na tanong",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Tanungin siya tungkol sa isang bagay na hindi mahalaga",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Tanungin siya tungkol sa pulitika",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Tanungin siya tungkol sa pinagmulan ng lahat ng pagdurusa",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Nasa mood akong maglaro ng ilang laro",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Maglaro tayo ng mga baraha",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Oras na para sa word chain!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Medyo gabi na pero gusto ko siyang makausap",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": " Sa tingin ko gustong makipag-usap ni bot…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Sabihin mo sa kanya na mahal mo siya!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Makipag-flirt sa bot <3",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Dapat mas mabait ako sa kanya...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Magtanong tungkol sa kanyang emosyon",
