  "m_Metadata": {
    "m_Items": [
      {
        "rid": 6437392580223180688
      }
    ]
  },
  "m_TableData": [
    {
      "m_Id": 3183073955840,
      "m_Localized": "Δοκίμασε πεις το όνομά της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "Μίλησέ της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "Δοκίμασε να της φωνάξεις",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "Δοκίμασε να της μιλήσεις",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "Πες γεια",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "Νιώθω μια περίεργη επιθυμία να της μιλήσω",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "Ας της μιλήσουμε",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "Πού να την κρύψω",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "Ας δούμε το μποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "Δοκίμασε να επικοινωνήσεις",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "Τι γίνεται με το ενοίκιο μου;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "Ανησυχώ...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "Τι ήταν αυτό;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "Πόσο είναι αξίζει αυτή;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "Η σεξουαλική μου ζωή",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "Μίλα με το μποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Μίλα με το μποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Μίλα με το μποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Ρώτα την για το δωμάτιο",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Αναρωτιέμαι τι σκέφτεται για μένα... ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Ίσως μπορεί να κάνει μαθηματικά;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Ρώτα την πώς να βγάλεις γρήγορα χρήματα",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Ρώτα την για τον καιρό",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Ρώτα την τι πιστεύει για το μέγεθος του...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Τι γινόταν με εκείνο το πράγμα με το καφέ ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Με εκνευρίζει...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Είναι ενοχλητική...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Ας προσπαθήσουμε να της μιλήσουμε",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Κάνε μια μικρή κουβέντα",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Μίλα μαζί της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Πες της να μιλήσει μαζί σου",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Ζήτησέ της όμορφα να μιλήσει",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Βαριέμαι…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Ας περάσουμε λίγο χρόνο μαζί της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Ας μιλήσουμε!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Κάνε στο μποτ μερικές υπαρξιακές ερωτήσεις",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Ρώτα την για κάτι ασήμαντο",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Ρώτα την για πολιτικά",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Ρώτα την για την πηγή όλων των βασάνων",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Έχω διάθεση να παίξω κανένα παιχνίδι",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Ας παίξουμε με κάρτες",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Ήρθε η ώρα για αλυσίδα λέξεων!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Είναι λίγο αργά αλλά θέλω να μιλήσω μαζί της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "Νομίζω ότι το μποτ θέλει να μιλήσει…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Πες της ότι την αγαπάς!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Φλέρταρε με το μποτ! <3",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Καλύτερα να είμαι πιο ευγενικός μαζί της...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Ρώτα για τα συναισθήματά της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "Έχει ένα σέξμποτ κανένα ενδιαφέρον;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733102,
      "m_Localized": "Πεινάει ποτέ ένα σέξμποτ;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733103,
      "m_Localized": "Θέλω να την αγγίξω. ..",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733104,
      "m_Localized": "Ξέχασα κάτι;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733105,
      "m_Localized": "Σχετικά με το επίπεδο νοημοσύνης του μποτ...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733106,
      "m_Localized": "Μπορεί ένα μποτ να παίξει σκάκι;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733107,
      "m_Localized": "Να δοκιμάσω άλλο παιχνίδι;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733108,
      "m_Localized": "Νομίζω ότι ξέρω σε ποιο παιχνίδι μπορώ να την κερδίσω...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733109,
      "m_Localized": "Το μποτ φαίνεται περίεργο...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733110,
      "m_Localized": "Αναρωτιέμαι πώς αισθάνεται για μένα…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733111,
      "m_Localized": "Το μποτ φαίνεται να είναι σε βαθιά σκέψη...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733112,
      "m_Localized": "Νομίζω ότι θέλει κάτι από μένα",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733113,
      "m_Localized": "Τώρα που έχει και τα δύο πόδια...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733114,
      "m_Localized": "Πρέπει να ρωτήσω το μποτ για τους κινδύνους να βγει έξω",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733115,
      "m_Localized": "Πρέπει να ρωτήσω για την πιθανότητα να βγει έξω",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733116,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733117,
      "m_Localized": "Σχετικά με τα σέξμποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733118,
      "m_Localized": "Ίσως μπορεί να μιλήσει τελικά;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733119,
      "m_Localized": "Ας μιλήσουμε ξανά",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733120,
      "m_Localized": "Κάτι δεν πάει καλά…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186710323200,
      "m_Localized": "Ποια είναι η γνώμη της για τα κατοικίδια;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906112,
      "m_Localized": "Θα πρέπει να την προσκαλέσω σε ραντεβού",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906113,
      "m_Localized": "Θέλω να δω μια ταινία μαζί της",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153391337472,
      "m_Localized": "Τι είναι αυτή η περίεργη μυρωδιά;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503296,
      "m_Localized": "Ρώτα για τις διακοσμήσεις του Χάλογουιν",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503297,
      "m_Localized": "Τι γίνεται με αυτή τη χαριτωμένη βελούδινη αράχνη;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 120816570795429888,
      "m_Localized": "Πρέπει να τη ρωτήσω αν μπορεί να έρθει η Σανίς",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 121488171031465984,
      "m_Localized": "Τι λες για καραόκε;",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 188424289878151168,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208135514265477120,
      "m_Localized": "Ρώτα την τι να κάνεις με την ταμεία",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208136759931822080,
      "m_Localized": "Προσπάθησε να της μιλήσεις ξανά",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208176712170594304,
      "m_Localized": "Ρώτα για τη Μελίσσα και τα μέρη που της «λείπουν»",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208184189855457280,
      "m_Localized": "Συζήτησε τα συναισθήματα του άστεγου για τα μποτ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208249514085048320,
      "m_Localized": "Ρώτα την πώς νιώθει μετά τις επισκευές",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 209124748665282560,
      "m_Localized": "Παρακολούθησε ειδήσεις με την {f_botName}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 6437392580223180688
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "Ποια υπερδύναμη θα θέλατε;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393790
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "Μια άλλη ιστορία τρόμου",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393791
          }
        ]
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "Τι κάνεις όταν είμαι έξω;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393792
          }
        ]
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "Αν μπορούσες να βρεις δουλειά, ποια θα ήταν αυτή;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393793
          }
        ]
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "Θα ήθελες να γίνεις άνθρωπος;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393794
          }
        ]
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "Εκδίκηση στον ιδιοκτήτη",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393795
          }
        ]
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "Ρωτήστε την πώς να αντιμετωπίσει τον προβληματικό γείτονα",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393796
          }
        ]
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "Τι πιστεύετε ότι συμβαίνει μετά τον θάνατο;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393797
          }
        ]
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "Έχετε κάποιο σχέδιο σε περίπτωση αποκάλυψης ζόμπι;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393798
          }
        ]
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "Ας δοκιμάσουμε ένα παιχνίδι ρόλων",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393799
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Θα βρει ποτέ η Άνναλι φίλο;",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393800
          }
        ]
      }
    }
  ],
