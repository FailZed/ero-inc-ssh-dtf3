        "m_Items": [
          {
            "rid": 7996671569124655200
          }
        ]
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Perguntar pra ela algumas questões existenciais",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Perguntar pra ela alguma coisa sem importância",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Perguntar pra ela sobre política",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Perguntar pra ela sobre a fonte de todo o sofrimento",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Tô com vontade de jogar algum jogo",
