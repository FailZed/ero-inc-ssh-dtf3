      "m_Localized": "Ce superputere ți-ai dori?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655626
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "O altă poveste de groază",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655627
          }
        ]
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "Ce faci când sunt afară?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655628
          }
        ]
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "Dacă te-ai putea duce la muncă, ce meserie ai alege?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655629
          }
        ]
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "Ai vrea să te transformi într-un om?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655630
          }
        ]
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "Răzbunare pe proprietar",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655631
          }
        ]
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "Întrebați-o cum să se descurce cu vecinul problematic",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655632
          }
        ]
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "Ce crezi că se întâmplă după moarte?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655633
          }
        ]
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "Ai un plan în cazul unei apocalipse zombie?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655634
          }
        ]
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "Hai să încercăm un joc de rol",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655635
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Oare Annalie își va găsi vreodată un iubit?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655636
          }
        ]
      }
    }
