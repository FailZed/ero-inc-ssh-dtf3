  "m_TableData": [
    {
      "m_Id": 3183073955840,
      "m_Localized": "彼女の名前を言ってみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "彼女と話す",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "彼女に電話してみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "彼女と話してみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "あいさつする",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "なぜか彼女と話したいという衝動を感じる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "彼女と話そう",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "彼女をどこに隠したらいい?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "ロボットを見てみよう",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "通信してみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "俺の家賃はどうだ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "心配だ…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "あれは何だったんだ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "彼女にはどれくらいの価値があるのだろう? ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "私の性活",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "ロボットと話す",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "ロボットと話す",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "ロボットと話す",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "俺の部屋について彼女に尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "彼女は俺のことをどう思っているのだろうか... ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "彼女は数学ができるのか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "手っ取り早くお金を稼ぐ方法を彼女に尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "天気について彼女に尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "彼女は俺のサイズをどう思っているのだろう...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "そのコーヒーのことはどうだ? ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "彼女は俺をいらいらさせる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "彼女がうっとうしく感じる...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "彼女と話してみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "雑談する",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "彼女と話す",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "あなたと話すように彼女に伝える",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "彼女に優しく話すように頼む",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "退屈だ...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "彼女と一緒に過ごす",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "会話の時間だ!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "ロボットに現実的な質問をする",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "たわいもないことを尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "政治について聞いてみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "すべての苦しみの源について聞く",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "ゲームをしたい気分だ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "カードで遊ぼう",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "ワードチェインの時間だ!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "ちょっと遅いが、彼女と話したい",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "ロボットが会話したがっているように言える",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "愛してると伝える!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "ロボットといちゃつく♥",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "もっと優しくした方がいいかもな…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "彼女の感情について聞いてみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "セックスボットは何に興味があるんだ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733102,
      "m_Localized": "セックスボットはお腹がすいたことってある?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733103,
      "m_Localized": "彼女に触れたい. ..",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733104,
      "m_Localized": "何か忘れたか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733105,
      "m_Localized": "ロボットの知性レベルについて...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733106,
      "m_Localized": "ロボットはチェスができるのか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733107,
      "m_Localized": "別のゲームを試してみるべきだろうか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733108,
      "m_Localized": "どんなゲームで彼女に勝てるかわかった気がする…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733109,
      "m_Localized": "ロボットが奇妙に見える...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733110,
      "m_Localized": "彼女は俺のことをどう思っているのだろうか...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733111,
      "m_Localized": "ロボットは考えこんでいるようだ...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733112,
      "m_Localized": "彼女は俺に何かを望んでいるようだ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733113,
      "m_Localized": "今の彼女には両足がある...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733114,
      "m_Localized": "外に出るリスクについてロボットに尋ねるべきだな",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733115,
      "m_Localized": "彼女が外に出る可能性について尋ねる必要があるな",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733116,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733117,
      "m_Localized": "セックスボットについて",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733118,
      "m_Localized": "結局彼女は話せるのかな?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733119,
      "m_Localized": "また話そう",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733120,
      "m_Localized": "なんか変な感じがする…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186710323200,
      "m_Localized": "彼女は頭を撫でることについてどう思っているのだろうか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906112,
      "m_Localized": "彼女をデートに誘うべきだな",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906113,
      "m_Localized": "一緒に映画を観たいな",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153391337472,
      "m_Localized": "あの変なにおいは何だ？",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503296,
      "m_Localized": "ハロウィーンの飾りについて聞く",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503297,
      "m_Localized": "かわいいクモのぬいぐるみはどう思う？",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 120816570795429888,
      "m_Localized": "シャニスが来てもいいか彼女に聞いてみようかな",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 121488171031465984,
      "m_Localized": "カラオケはどうだ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 188424289878151168,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208135514265477120,
      "m_Localized": "レジ係をどうするか彼女に尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208136759931822080,
      "m_Localized": "もう一度彼女に話しかけてみる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208176712170594304,
      "m_Localized": "メリッサと彼女の「欠けている」部品について尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208184189855457280,
      "m_Localized": "ロボットに対するホーボーの感情について話し合う",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393377
          }
        ]
      }
    },
    {
      "m_Id": 208249514085048320,
      "m_Localized": "修理後の気分を彼女に尋ねる",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393378
          }
        ]
      }
    },
    {
      "m_Id": 209124748665282560,
      "m_Localized": "{f_botName} でニュースを見よう",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 6437392580223180687
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "どんなスーパーパワーが欲しい？",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "もう一つの怖い話",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "俺がいないときは何をしているの？",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "仕事に就けるとしたら、何の仕事に就く?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "人間になりたいと思う?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "大家への復讐",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "問題のある隣人に対処する方法を彼女に尋ねる",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": " 死んだ後はどうなると思う?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": " ゾンビの黙示録への備えはありますか?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": " ロールプレイング ゲームを試してみましょう",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393379
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": " アナリーは彼氏を見つけるつもりなのか?",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
