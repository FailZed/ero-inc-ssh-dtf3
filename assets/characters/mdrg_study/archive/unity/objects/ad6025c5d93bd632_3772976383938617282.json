  "m_TableData": [
    {
      "m_Id": 3183073955840,
      "m_Localized": "Сказать её имя",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393559
          }
        ]
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "Поговорить с ней",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "Окликнуть её",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393560
          }
        ]
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "Попробовать поговорить с ней",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "Поздороваться",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "У меня странное желание поговорить с ней",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393561
          }
        ]
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "Поговорить с ней",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393562
          }
        ]
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "Где её спрятать",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "Посмотреть на бота",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "Попробовать общаться",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "Что насчёт квартплаты?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "Я обеспокоен...",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393563
          }
        ]
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "Что это было?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "Сколько она стоит?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "Моя сексуальная жизнь",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "Поговорить с ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Поговорить с ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Поговорить с ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Спросить её о комнате",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Интересно, что она обо мне думает...",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393564
          }
        ]
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Может, она сильна в математике?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393565
          }
        ]
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Спросить, как быстро заработать денег",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393566
          }
        ]
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Спросить её о погоде",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Спросить её, что она думает о размере моего...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Что было с кофеваркой?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393567
          }
        ]
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Она меня бесит...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Она раздражает...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Попробую поговорить с ней",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Немного поболтать",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Поговорить с ней",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Попросить её поговорить с тобой",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Вежливо попросить её поговорить с тобой",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Мне скучно…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Провести немного времени вместе",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Поболтаем!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Задать боту несколько экзистенциальных вопросов",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Спросить её о пустяках",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393568
          }
        ]
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Спросить её о политике",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Спросить её об источнике всех страданий",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "У меня есть настрой на игры",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393569
          }
        ]
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Сыграем в карты",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Поиграем в слова!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393570
          }
        ]
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Уже поздновато, но я хочу поговорить с ней",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "Думаю, она хочет поговорить...",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393571
          }
        ]
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Сказать, что любишь её!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393572
          }
        ]
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Флиртовать с ботом <3",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Мне стоит к ней лучше относиться...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Спросить о её эмоциях",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393573
          }
        ]
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "У сексботов есть хобби?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393574
          }
        ]
      }
    },
    {
      "m_Id": 3183090733102,
      "m_Localized": "Сексбот может испытывать голод?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393575
          }
        ]
      }
    },
    {
      "m_Id": 3183090733103,
      "m_Localized": "Хочу её потрогать...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733104,
      "m_Localized": "Я ничего не забыл?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733105,
      "m_Localized": "Об уровне интеллекта бота...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733106,
      "m_Localized": "Умеет ли она играть в шахматы?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393576
          }
        ]
      }
    },
    {
      "m_Id": 3183090733107,
      "m_Localized": "Может, сыграть в другую игру?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393577
          }
        ]
      }
    },
    {
      "m_Id": 3183090733108,
      "m_Localized": "Кажется, я знаю в какой игре её можно выиграть...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733109,
      "m_Localized": "С ботом что-то не так...",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393578
          }
        ]
      }
    },
    {
      "m_Id": 3183090733110,
      "m_Localized": "Интересно, что она обо мне думает...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733111,
      "m_Localized": "Кажется, она о чём-то глубоко задумалась...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733112,
      "m_Localized": "Похоже, она что-то хочет от меня",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733113,
      "m_Localized": "Теперь, раз у неё обе ноги...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733114,
      "m_Localized": "Стоит спроить бота о рисках выхода на улицу",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733115,
      "m_Localized": "Нужно спросить о её возможности выхода на улицу",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393579
          }
        ]
      }
    },
    {
      "m_Id": 3183090733116,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733117,
      "m_Localized": "О сексботах",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733118,
      "m_Localized": "Может, она всё-таки умеет разговаривать?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733119,
      "m_Localized": "Поговорить снова",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733120,
      "m_Localized": "Что-то не так...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186710323200,
      "m_Localized": "Как она относится к домашним питомцам?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393580
          }
        ]
      }
    },
    {
      "m_Id": 38378186722906112,
      "m_Localized": "Я должен пригласить её на свидание",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906113,
      "m_Localized": "Хочу посмотреть с ней фильм",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153391337472,
      "m_Localized": "Чем так странно пахнет?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393581
          }
        ]
      }
    },
    {
      "m_Id": 45696153416503296,
      "m_Localized": "Спросить об украшениях на Хэллоуин",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503297,
      "m_Localized": "Как насчёт милого плюшевого паучка?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 120816570795429888,
      "m_Localized": "Следует спросить её, может ли Шанис прийти к нам домой",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393582
          }
        ]
      }
    },
    {
      "m_Id": 121488171031465984,
      "m_Localized": "Как насчёт караоке?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 188424289878151168,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208135514265477120,
      "m_Localized": "Спросить её, что делать с кассиром",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393583
          }
        ]
      }
    },
    {
      "m_Id": 208136759931822080,
      "m_Localized": "Попробовать поговорить с ней еще раз",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208176712170594304,
      "m_Localized": "Спросить о Мелиссе и её \"недостающих\" деталях",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208184189855457280,
      "m_Localized": "Обсудить отношение бомжа к ботам",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208249514085048320,
      "m_Localized": "Спросить о её самочувствии после ремонта",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393584
          }
        ]
      }
    },
    {
      "m_Id": 209124748665282560,
      "m_Localized": "Посмотреть новости с {f_botName}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 6437392580223180675
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "Какой суперсилой ты бы хотела обладать?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393585
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "Ещё одна страшилка",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "Что ты делаешь, когда меня нет?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "Если бы ты могла найти работу, что бы это было?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "Хотела бы ты стать человеком?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "Месть арендодателю",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "Спросите её, как справиться с проблемным соседом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "Как ты думаешь, что произойдет после смерти?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "Есть ли у тебя план на случай зомби-апокалипсиса?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "Давай поиграем в ролевую игру",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Найдёт ли Аннали когда-нибудь парня?",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
