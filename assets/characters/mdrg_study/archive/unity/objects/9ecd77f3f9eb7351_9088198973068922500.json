  "m_TableData": [
    {
      "m_Id": 3183073955840,
      "m_Localized": "Womöglich reagiert sie auf ihren Namen?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393282
          }
        ]
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "Sprich sie an",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393283
          }
        ]
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "Versuch eine Reaktion von ihr zu bekommen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393284
          }
        ]
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "Versuch eine Antwort von ihr zu bekommen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393285
          }
        ]
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "Sag Hi",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393286
          }
        ]
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "Ich hab das Verlangen mit ihr zu reden",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393287
          }
        ]
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "Rede mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393288
          }
        ]
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "Wo könnte ich sie verstecken…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393289
          }
        ]
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "Ich sollte sie mir genauer ansehen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393290
          }
        ]
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "Versuchen dich mich mit ihr zu Unterhalten",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393291
          }
        ]
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "Was soll ich nur wegen der Miete unternehmen…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393292
          }
        ]
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "Ich kann sie nirgendwo verstecken…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393293
          }
        ]
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "Was war das?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393294
          }
        ]
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "Wieviel könnte sie womöglich Wert sein?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393295
          }
        ]
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "Jetzt wo ich ein Sexbot habe…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393296
          }
        ]
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "Sprich mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393297
          }
        ]
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Sprich mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393298
          }
        ]
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Sprich mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393299
          }
        ]
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Was sie wohl von meiner Wohnung hält?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393300
          }
        ]
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Ich frage mich, was sie über mich denkt…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393301
          }
        ]
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Vielleicht hat sie ja Mathe drauf?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393302
          }
        ]
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Ob sie weiß, wie ich schnell Geld verdienen könnte?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393303
          }
        ]
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Sprich das Wetter an",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393304
          }
        ]
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Was sie wohl über die Größe meines Glieds denkt…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393305
          }
        ]
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Vielleicht kann sie mir wegen der Kaffeemaschine helfen?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393306
          }
        ]
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393307
          }
        ]
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Sie geht mir auf den Sack…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393308
          }
        ]
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Ist sie nervig…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393309
          }
        ]
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Ich sollte nochmal versuchen mit ihr zu sprechen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393310
          }
        ]
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Smalltalk",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393311
          }
        ]
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Unterhalte dich mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393312
          }
        ]
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Sag ihr, dass sie wieder mit dir sprechen soll",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393313
          }
        ]
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Sag ihr, dass sie netter mit dir reden soll",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393314
          }
        ]
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Mir ist langweilig…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393315
          }
        ]
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Verbringe etwas Zeit mit ihr",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393316
          }
        ]
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Lass miteinander quatschen!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393317
          }
        ]
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Stell ihr tiefsinnige fragen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393318
          }
        ]
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Rede mit ihr über alles mögliche",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393319
          }
        ]
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Sprich sie das Thema Politik an",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393320
          }
        ]
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Befrage sie nach der Quelle von allem Leid",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393321
          }
        ]
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Mir ist gerade danach, ein paar Spiele mit ihr zu spielen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393322
          }
        ]
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Lass uns mit Karten spielen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393323
          }
        ]
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Zeit für eine Runde Wortkette!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393324
          }
        ]
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Es ist schon spät, aber ich möchte mich mit ihr unterhalten",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393325
          }
        ]
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "Ich glaube, sie möchte mit mir über etwas sprechen",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393326
          }
        ]
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Ich sollte ihr sagen, dass ich sie liebe!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393327
          }
        ]
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Flirte mit Bot <3",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393328
          }
        ]
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Ich sollte netter zu ihr sein…",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393329
          }
        ]
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Wie fühlt sie sich wohl gerade?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124393330
          }
        ]
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "Ob sie womöglich irgendwelche Interessen hat?",
