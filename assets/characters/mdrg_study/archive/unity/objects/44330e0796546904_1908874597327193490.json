  },
  "m_Name": "Dialogue_uk",
  "m_LocaleId": {
    "m_Code": "uk"
  },
  "m_SharedData": {
    "m_FileID": 2,
    "m_PathID": 9024666039417792656
  },
  "m_Metadata": {
    "m_Items": [
      {
        "rid": 6437392580223180690
      }
    ]
  },
  "m_TableData": [
    {
      "m_Id": 3183090733120,
      "m_Localized": "Щось не так…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733119,
      "m_Localized": "Давайте поговоримо знову ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733118,
      "m_Localized": "Можливо, вона все-таки вміє говорити?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733117,
      "m_Localized": "Про секс-ботів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733116,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733115,
      "m_Localized": "Мені потрібно запитати про можливості її виходу на вулицю",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733114,
      "m_Localized": "Варто запитати бота про ризики виходу на вулицю",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733113,
      "m_Localized": "Тепер, коли вона має обидві ноги...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733112,
      "m_Localized": "Я думаю, що вона хоче чогось від мене",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733111,
      "m_Localized": "Бот, здається, глибоко задумався...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733110,
      "m_Localized": "Цікаво, що вона думає про мене…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733109,
      "m_Localized": "Бот здається дивним...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733108,
      "m_Localized": "Мені здається, я знаю, в якій грі я можу перемогти її...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733107,
      "m_Localized": "Може варто мені спробувати іншу гру?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733106,
      "m_Localized": "Чи може бот грати в шахи?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733105,
      "m_Localized": "Про рівень інтелекту бота...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733104,
      "m_Localized": "Я щось забув?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733103,
      "m_Localized": "Я хочу доторкнутися її...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733102,
      "m_Localized": "Чи відчуває бот голод",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655338
          }
        ]
      }
    },
    {
      "m_Id": 3183090733101,
      "m_Localized": "Чи є у секс-бота якісь інтереси?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733100,
      "m_Localized": "Запитати про її емоції",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733099,
      "m_Localized": "Варто бути добрішим до неї...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733098,
      "m_Localized": "Фліртувати з ботом <3",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733097,
      "m_Localized": "Сказати їй, що ти її любиш!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733096,
      "m_Localized": "Я думаю, що бот хоче поговорити…",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733095,
      "m_Localized": "Трохи пізно, але я хочу з нею поговорити",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733094,
      "m_Localized": "Настав час гри в ланцюжок слів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733093,
      "m_Localized": "Давайте пограємо в карти ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733092,
      "m_Localized": "Я в настрої пограти в ігри ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733091,
      "m_Localized": "Запитати її про джерело всіх страждань",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733090,
      "m_Localized": "Запитати її про політику",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733089,
      "m_Localized": "Запитати її про щось неважливе",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733088,
      "m_Localized": "Запитати про сенс життя",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733087,
      "m_Localized": "Давайте балакати!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733086,
      "m_Localized": "Давай проведу трохи часу з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733085,
      "m_Localized": "Мені нудно...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733084,
      "m_Localized": "Попросити її говорити ніжно",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733083,
      "m_Localized": "Сказати їй поговорити з тобою",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733082,
      "m_Localized": "Поговорити з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733081,
      "m_Localized": "Невелика розмова",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733080,
      "m_Localized": "Спробую поговорити з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733079,
      "m_Localized": "Вона дратує...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733078,
      "m_Localized": "Вона мене бісить...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733077,
      "m_Localized": "...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733076,
      "m_Localized": "Той випадок з кавою",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733075,
      "m_Localized": "Запитати її, що вона думає про розмір мого...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733074,
      "m_Localized": "Запитати її про погоду",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733073,
      "m_Localized": "Запитати її про способи швидкого заробітку",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733072,
      "m_Localized": "Може вона знає математику?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733071,
      "m_Localized": "Цікаво, що вона про мене думає...",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733070,
      "m_Localized": "Запитати її про мою кімнату",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733069,
      "m_Localized": "Поговорити з ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733068,
      "m_Localized": "Поговорити з ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733067,
      "m_Localized": "Поговорити з ботом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733066,
      "m_Localized": "Моє сексуальне життя",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733065,
      "m_Localized": "Скільки вона коштує? ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733064,
      "m_Localized": "Що це було? ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733063,
      "m_Localized": "Я стурбований... ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733062,
      "m_Localized": "Що з моєю орендною платою? ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733061,
      "m_Localized": "Спробувати спілкуватися",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733060,
      "m_Localized": "Давайте подивимося на бота",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733059,
      "m_Localized": "Де мені її сховати",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733058,
      "m_Localized": "Давай поговоримо з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733057,
      "m_Localized": "Я відчуваю дивне бажання поговорити з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183090733056,
      "m_Localized": "Привітатися",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538754,
      "m_Localized": "Спробувати поговорити з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538753,
      "m_Localized": "Спробувати позвати її",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183086538752,
      "m_Localized": "Поговорити з нею",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3183073955840,
      "m_Localized": "Спробувати назвати її ім'я",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655339
          }
        ]
      }
    },
    {
      "m_Id": 38378186710323200,
      "m_Localized": "Яка її думка про домашніх тварин?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906112,
      "m_Localized": "Варто запросити її на побачення",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 38378186722906113,
      "m_Localized": "Я хочу подивитися з нею фільм",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153391337472,
      "m_Localized": "Що це за дивний запах?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503296,
      "m_Localized": "Запитайте про прикраси на Хелловін",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 45696153416503297,
      "m_Localized": "А як щодо того милого плюшевого павука?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 120816570795429888,
      "m_Localized": "Я маю запитати її, чи може Шаніс прийти",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 121488171031465984,
      "m_Localized": "Як щодо караоке?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 188424289878151168,
      "m_Localized": "???",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208135514265477120,
      "m_Localized": "Запитати її, що робити з касиром",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208136759931822080,
      "m_Localized": "Спробувати поговорити з нею ще раз",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208176712170594304,
      "m_Localized": "Розпитати про Мелісу та її 'відсутні' частини",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208184189855457280,
      "m_Localized": "Обговорити ставлення бомжів до ботів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 208249514085048320,
      "m_Localized": "Запитати її, як вона почувається після ремонту",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 209124748665282560,
      "m_Localized": "Подивитися новини з {f_botName}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 6437392580223180690
          }
        ]
      }
    },
    {
      "m_Id": 329561421806297088,
      "m_Localized": "Яку суперсилу ти б хотіла?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655340
          }
        ]
      }
    },
    {
      "m_Id": 329562090420297728,
      "m_Localized": "Інша історія жахів",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655341
          }
        ]
      }
    },
    {
      "m_Id": 333743964759777280,
      "m_Localized": "Що ти робиш, коли мене немає?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655342
          }
        ]
      }
    },
    {
      "m_Id": 333743972154335232,
      "m_Localized": "Якби ти могла знайти роботу, що б це була за робота?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655343
          }
        ]
      }
    },
    {
      "m_Id": 333743980517777408,
      "m_Localized": "Хотіла б перетворитися на людину?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655344
          }
        ]
      }
    },
    {
      "m_Id": 454075064358264832,
      "m_Localized": "Помститися орендодавцю",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655345
          }
        ]
      }
    },
    {
      "m_Id": 496812532128681984,
      "m_Localized": "Запитати її, як впоратися з проблемним сусідом",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655346
          }
        ]
      }
    },
    {
      "m_Id": 496882784552226816,
      "m_Localized": "Як гадаєш, що станеться після смерті?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655347
          }
        ]
      }
    },
    {
      "m_Id": 496884597502382080,
      "m_Localized": "У тебе є план на випадок зомбі-апокаліпсису?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655348
          }
        ]
      }
    },
    {
      "m_Id": 496885401596596224,
      "m_Localized": "Спробуймо рольову гру",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655349
          }
        ]
      }
    },
    {
      "m_Id": 496886190553567232,
      "m_Localized": "Чи знайде Анналі коли-небудь хлопця?",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 7996671569124655350
          }
        ]
      }
    }
  ],
