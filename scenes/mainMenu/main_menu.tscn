[sub_resource type="Shader" id="Shader_aside_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_radius = 4.0;
uniform float overlay_alpha = 0.42;

void fragment() {
	vec2 px = SCREEN_PIXEL_SIZE * blur_radius;
	vec4 color = texture(screen_texture, SCREEN_UV) * 0.20;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, 0.0)) * 0.13;
	color += texture(screen_texture, SCREEN_UV - vec2(px.x, 0.0)) * 0.13;
	color += texture(screen_texture, SCREEN_UV + vec2(0.0, px.y)) * 0.13;
	color += texture(screen_texture, SCREEN_UV - vec2(0.0, px.y)) * 0.13;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, px.y)) * 0.07;
	color += texture(screen_texture, SCREEN_UV + vec2(-px.x, px.y)) * 0.07;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, -px.y)) * 0.07;
	color += texture(screen_texture, SCREEN_UV + vec2(-px.x, -px.y)) * 0.07;
	COLOR = vec4(color.rgb, overlay_alpha);
}"

